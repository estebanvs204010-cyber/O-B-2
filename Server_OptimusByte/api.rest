@baseUrl = http://localhost:8002

@correoCliente = louisfonseca070@gmail.com
@contrasenaCliente = TU_CONTRASENA

### LOGIN CLIENTE
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "correo": "{{correoCliente}}",
  "contrasena": "{{contrasenaCliente}}"
}

### SESION CLIENTE
# Ejecutar después de LOGIN CLIENTE
GET {{baseUrl}}/api/cliente/me

### VEHICULOS DEL CLIENTE
GET {{baseUrl}}/api/cliente/mis-vehiculos

### REGISTRAR VEHICULO DEL CLIENTE
POST {{baseUrl}}/api/cliente/mis-vehiculos
Content-Type: application/json

{
  "placa": "AKL123",
  "marca": "Chevrolet",
  "modelo": "Spark",
  "anio": 2021,
  "km_actuales": 30000
}

### ACTUALIZAR PERFIL DEL CLIENTE
PUT {{baseUrl}}/api/cliente/me
Content-Type: application/json

{
  "nombre_completo": "Louis Fonseca",
  "correo": "louisfonseca070@gmail.com",
  "telefono": "3000000000",
  "direccion": "Dirección de prueba"
}

### SOLICITAR RECUPERACION DE CONTRASEÑA
POST {{baseUrl}}/api/auth/solicitar-recuperacion
Content-Type: application/json

{
  "correo": "{{correoCliente}}"
}

### CERRAR SESION
POST {{baseUrl}}/api/auth/logout