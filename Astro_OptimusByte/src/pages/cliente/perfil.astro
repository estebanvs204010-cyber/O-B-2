---
import ClienteLayout from "../../layouts/ClienteLayout.astro";
---

<ClienteLayout title="Mi perfil" active="perfil">
  <div id="mensaje" class="alert" hidden></div>

  <div class="profile-page">
    <div class="profile-layout">
      <section class="profile-card">
        <div class="profile-identity">
          <div class="profile-avatar">
            <img id="fotoPerfil" alt="Foto de perfil" hidden />
            <span id="avatar">--</span>
          </div>

          <div class="profile-user-info">
            <h2 id="nombre">Cargando...</h2>
            <p id="correo">Cargando...</p>

            <label class="photo-button" for="fotoInput">
              Cambiar foto
            </label>

            <input
              id="fotoInput"
              type="file"
              accept="image/png,image/jpeg,image/webp"
              hidden
            />
          </div>
        </div>

        <div class="profile-security">
          <h3>Seguridad</h3>

          <p>
            Recibirás un enlace de verificación en tu correo.
          </p>

          <button
            id="cambiarPassword"
            class="btn btn-outline"
            type="button"
          >
            Cambiar contraseña por correo
          </button>
        </div>
      </section>

      <section class="profile-section">
        <div class="panel-heading-row">
          <div>
            <h2>Información personal</h2>
            <p>Datos asociados a tu cuenta.</p>
          </div>

          <button
            id="editarPerfil"
            class="btn btn-outline"
            type="button"
          >
            Editar perfil
          </button>
        </div>

        <div id="datosPerfil">
          <div class="profile-data">
            <div class="profile-data-item">
              <strong>Teléfono</strong>
              <span id="telefono">Cargando...</span>
            </div>

            <div class="profile-data-item">
              <strong>Dirección</strong>
              <span id="direccion">Cargando...</span>
            </div>
          </div>

          <div class="profile-protected">
            <div class="profile-protected-icon">
              PROTEGIDO
            </div>

            <div>
              <strong>Documento</strong>
              <small id="documento">Cargando...</small>
              <small>Este dato no se puede modificar.</small>
            </div>
          </div>
        </div>

        <form id="perfilForm" class="form-grid" hidden>
          <div class="field">
            <label for="nombreInput">Nombre completo</label>
            <input id="nombreInput" type="text" required />
          </div>

          <div class="field">
            <label for="correoInput">Correo</label>
            <input id="correoInput" type="email" required />
          </div>

          <div class="field">
            <label for="telefonoInput">Teléfono</label>
            <input id="telefonoInput" type="tel" required />
          </div>

          <div class="field">
            <label for="direccionInput">Dirección</label>
            <input id="direccionInput" type="text" />
          </div>

          <div class="field">
            <label for="documentoInput">Documento</label>
            <input id="documentoInput" type="text" disabled />
            <small>El documento no se puede modificar.</small>
          </div>

          <div class="form-actions">
            <button class="btn btn-primary" type="submit">
              Guardar cambios
            </button>

            <button
              id="cancelarEdicion"
              class="btn btn-outline"
              type="button"
            >
              Cancelar
            </button>
          </div>
        </form>
      </section>
    </div>
  </div>
</ClienteLayout>

<script>
  import { apiFetch } from "../../lib/api";

  interface Perfil {
    nombre_completo?: string;
    correo?: string;
    telefono?: string | null;
    direccion?: string | null;
    tipo_documento?: string | null;
    num_documento?: string | null;
    documento?: string | null;
    numero_documento?: string | null;
    foto_perfil?: string | null;
  }

  const mensaje = document.getElementById("mensaje") as HTMLDivElement;
  const datosPerfil = document.getElementById("datosPerfil") as HTMLDivElement;
  const perfilForm = document.getElementById("perfilForm") as HTMLFormElement;
  const editarPerfil = document.getElementById("editarPerfil") as HTMLButtonElement;
  const cancelarEdicion = document.getElementById("cancelarEdicion") as HTMLButtonElement;
  const cambiarPassword = document.getElementById("cambiarPassword") as HTMLButtonElement;
  const fotoInput = document.getElementById("fotoInput") as HTMLInputElement;

  let perfilActual: Perfil = {};

  function mostrarMensaje(
    texto: string,
    tipo: "success" | "error",
  ) {
    mensaje.textContent = texto;
    mensaje.className = `alert alert-${tipo}`;
    mensaje.hidden = false;
  }

  function ocultarMensaje() {
    mensaje.hidden = true;
    mensaje.textContent = "";
  }

  function valor(value?: string | null): string {
    return value?.trim() || "No registrado";
  }

  function obtenerDocumento(perfil: Perfil): string {
    if (perfil.documento) {
      return perfil.documento;
    }

    if (perfil.numero_documento) {
      return perfil.numero_documento;
    }

    if (perfil.num_documento) {
      return perfil.tipo_documento
        ? `${perfil.tipo_documento} ${perfil.num_documento}`
        : perfil.num_documento;
    }

    return "No registrado";
  }

  function obtenerIniciales(nombre?: string): string {
    if (!nombre) {
      return "--";
    }

    const palabras = nombre
      .trim()
      .split(/\s+/)
      .filter(Boolean);

    if (palabras.length === 1) {
      return palabras[0]
        .substring(0, 2)
        .toUpperCase();
    }

    return (
      palabras[0][0] + palabras[1][0]
    ).toUpperCase();
  }

  function pintarPerfil(perfil: Perfil) {
    perfilActual = perfil;

    const foto = document.getElementById(
      "fotoPerfil",
    ) as HTMLImageElement;

    const avatar = document.getElementById(
      "avatar",
    ) as HTMLSpanElement;

    document.getElementById("nombre")!.textContent =
      valor(perfil.nombre_completo);

    document.getElementById("correo")!.textContent =
      valor(perfil.correo);

    document.getElementById("telefono")!.textContent =
      valor(perfil.telefono);

    document.getElementById("direccion")!.textContent =
      valor(perfil.direccion);

    document.getElementById("documento")!.textContent =
      obtenerDocumento(perfil);

    avatar.textContent = obtenerIniciales(
      perfil.nombre_completo,
    );

    if (perfil.foto_perfil) {
      foto.src = perfil.foto_perfil;
      foto.hidden = false;
      avatar.hidden = true;
    } else {
      foto.hidden = true;
      avatar.hidden = false;
    }

    (
      document.getElementById(
        "nombreInput",
      ) as HTMLInputElement
    ).value = perfil.nombre_completo ?? "";

    (
      document.getElementById(
        "correoInput",
      ) as HTMLInputElement
    ).value = perfil.correo ?? "";

    (
      document.getElementById(
        "telefonoInput",
      ) as HTMLInputElement
    ).value = perfil.telefono ?? "";

    (
      document.getElementById(
        "direccionInput",
      ) as HTMLInputElement
    ).value = perfil.direccion ?? "";

    (
      document.getElementById(
        "documentoInput",
      ) as HTMLInputElement
    ).value = obtenerDocumento(perfil);
  }

  async function cargarPerfil() {
    try {
      const resultado = await apiFetch<Perfil>(
        "/api/cliente/me",
      );

      pintarPerfil(resultado.data ?? {});
    } catch (error) {
      mostrarMensaje(
        error instanceof Error
          ? error.message
          : "No se pudo cargar el perfil.",
        "error",
      );
    }
  }

  editarPerfil.addEventListener("click", () => {
    ocultarMensaje();
    datosPerfil.hidden = true;
    perfilForm.hidden = false;
    editarPerfil.hidden = true;
  });

  cancelarEdicion.addEventListener("click", () => {
    pintarPerfil(perfilActual);

    datosPerfil.hidden = false;
    perfilForm.hidden = true;
    editarPerfil.hidden = false;

    ocultarMensaje();
  });

  perfilForm.addEventListener("submit", async (event) => {
    event.preventDefault();
    ocultarMensaje();

    const body = {
      nombre_completo: (
        document.getElementById(
          "nombreInput",
        ) as HTMLInputElement
      ).value.trim(),

      correo: (
        document.getElementById(
          "correoInput",
        ) as HTMLInputElement
      ).value.trim(),

      telefono: (
        document.getElementById(
          "telefonoInput",
        ) as HTMLInputElement
      ).value.trim(),

      direccion: (
        document.getElementById(
          "direccionInput",
        ) as HTMLInputElement
      ).value.trim(),
    };

    try {
      const resultado = await apiFetch<Perfil>(
        "/api/cliente/me",
        {
          method: "PUT",
          body: JSON.stringify(body),
        },
      );

      pintarPerfil({
        ...perfilActual,
        ...body,
        ...(resultado.data ?? {}),
      });

      datosPerfil.hidden = false;
      perfilForm.hidden = true;
      editarPerfil.hidden = false;

      mostrarMensaje(
        resultado.message ??
          "Perfil actualizado correctamente.",
        "success",
      );
    } catch (error) {
      mostrarMensaje(
        error instanceof Error
          ? error.message
          : "No se pudo actualizar el perfil.",
        "error",
      );
    }
  });

  fotoInput.addEventListener("change", () => {
    const archivo = fotoInput.files?.[0];

    if (!archivo) {
      return;
    }

    if (!archivo.type.startsWith("image/")) {
      mostrarMensaje(
        "Selecciona una imagen válida.",
        "error",
      );
      return;
    }

    if (archivo.size > 5 * 1024 * 1024) {
      mostrarMensaje(
        "La imagen no puede superar los 5 MB.",
        "error",
      );
      return;
    }

    const lector = new FileReader();

    lector.onload = async () => {
      const fotoPerfil = String(lector.result);

      try {
        const resultado = await apiFetch(
          "/api/cliente/foto",
          {
            method: "PUT",
            body: JSON.stringify({
              foto_perfil: fotoPerfil,
            }),
          },
        );

        perfilActual.foto_perfil = fotoPerfil;
        pintarPerfil(perfilActual);

        mostrarMensaje(
          resultado.message ??
            "Foto actualizada correctamente.",
          "success",
        );
      } catch (error) {
        mostrarMensaje(
          error instanceof Error
            ? error.message
            : "No se pudo guardar la foto.",
          "error",
        );
      }
    };

    lector.readAsDataURL(archivo);
  });

  cambiarPassword.addEventListener(
    "click",
    async () => {
      if (!perfilActual.correo) {
        mostrarMensaje(
          "No se encontró el correo del perfil.",
          "error",
        );
        return;
      }

      try {
        const resultado = await apiFetch(
          "/api/auth/solicitar-recuperacion",
          {
            method: "POST",
            body: JSON.stringify({
              correo: perfilActual.correo,
            }),
          },
        );

        mostrarMensaje(
          resultado.message ??
            "Revisa tu correo.",
          "success",
        );
      } catch (error) {
        mostrarMensaje(
          error instanceof Error
            ? error.message
            : "No se pudo enviar el correo.",
          "error",
        );
      }
    },
  );

  cargarPerfil();
</script>

<style>
  .profile-page {
    min-height: calc(100vh - 150px);
    display: grid;
    place-items: center;
    padding: 32px 24px;
  }

  .profile-layout {
    width: min(980px, 100%);
    max-width: 980px;
    display: grid;
    grid-template-columns: minmax(260px, 0.75fr) minmax(0, 1.25fr);
    background: #ffffff;
    border: 1px solid #dbe4ef;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 10px 28px rgba(15, 45, 85, 0.08);
  }

  .profile-card,
  .profile-section {
    min-width: 0;
    padding: 36px;
    background: transparent;
    border: 0;
    box-shadow: none;
  }

  .profile-card {
    border-right: 1px solid #dbe4ef;
  }

  .profile-identity {
    display: flex;
    align-items: center;
    gap: 16px;
    min-width: 0;
    padding-bottom: 24px;
    border-bottom: 1px solid #dbe4ef;
  }

  .profile-avatar {
    width: 82px;
    height: 82px;
    min-width: 82px;
    min-height: 82px;
    flex: 0 0 82px;
    position: relative;
    overflow: hidden;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: #183961;
    color: #ffffff;
    font-size: 26px;
    font-weight: 800;
  }

  .profile-avatar img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  .profile-avatar span {
    position: relative;
    z-index: 1;
  }

  .profile-user-info {
    min-width: 0;
    overflow: hidden;
  }

  .profile-user-info h2 {
    margin: 0 0 6px;
    color: #0f315b;
    overflow-wrap: anywhere;
  }

  .profile-user-info p {
    margin: 0;
    color: #7190b5;
    overflow-wrap: anywhere;
  }

  .photo-button {
    display: inline-block;
    margin-top: 10px;
    color: #1769e8;
    cursor: pointer;
    font-size: 13px;
    font-weight: 700;
  }

  .photo-button:hover {
    text-decoration: underline;
  }

  .profile-security {
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid #dbe4ef;
  }

  .profile-security h3 {
    margin: 0 0 8px;
    color: #0f315b;
  }

  .profile-security p {
    margin: 0 0 18px;
    color: #7190b5;
  }

  .profile-data {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .profile-data-item {
    min-height: 82px;
    padding: 16px;
    border: 1px solid #dbe4ef;
    border-radius: 8px;
    background: #f8fafc;
  }

  .profile-data-item strong {
    display: block;
    margin-bottom: 8px;
    color: #7190b5;
    font-size: 13px;
  }

  .profile-data-item span {
    color: #0f315b;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .profile-protected {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-top: 16px;
    padding: 16px;
    border: 1px solid #d8e3f1;
    border-radius: 8px;
    background: #eef5ff;
  }

  .profile-protected-icon {
    color: #1769e8;
    font-size: 11px;
    font-weight: 800;
    white-space: nowrap;
  }

  .profile-protected strong {
    display: block;
    color: #0f315b;
  }

  .profile-protected small {
    display: block;
    margin-top: 4px;
    color: #7190b5;
  }

  @media (max-width: 800px) {
    .profile-page {
      min-height: auto;
      padding: 24px 12px;
    }

    .profile-layout {
      grid-template-columns: 1fr;
    }

    .profile-card {
      border-right: 0;
      border-bottom: 1px solid #dbe4ef;
    }

    .profile-card,
    .profile-section {
      padding: 24px;
    }

    .profile-data {
      grid-template-columns: 1fr;
    }
  }
</style>