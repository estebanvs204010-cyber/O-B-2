---
import ClienteLayout from "../../layouts/ClienteLayout.astro";

const cliente: any = null;

const vehiculos: any[] = [];
const ordenes: any[] = [];
const citas: any[] = [];
const pagos: any[] = [];
const recordatorios: any[] = [];
---

<ClienteLayout title="Panel del Cliente" active="inicio">
  <section class="page-grid">
    <div class="summary-grid" aria-label="Resumen del cliente">
      <article class="metric-card">
        <p class="metric-label">Vehiculos</p>
        <div>
          <p class="metric-value">{vehiculos.length}</p>
          <p class="metric-note">Registrados en tu cuenta</p>
        </div>
      </article>

      <article class="metric-card">
        <p class="metric-label">Ordenes</p>
        <div>
          <p class="metric-value">{ordenes.length}</p>
          <p class="metric-note">Historial reciente</p>
        </div>
      </article>

      <article class="metric-card">
        <p class="metric-label">Citas</p>
        <div>
          <p class="metric-value">{citas.length}</p>
          <p class="metric-note">Proximas visitas</p>
        </div>
      </article>

      <article class="metric-card">
        <p class="metric-label">Pagos</p>
        <div>
          <p class="metric-value">{pagos.length}</p>
          <p class="metric-note">Facturas y pagos</p>
        </div>
      </article>
    </div>

    <div class="content-columns">
      <div class="page-grid">
        <section class="panel" id="vehiculos">
          <div class="panel-header">
            <div>
              <h2 class="panel-title">Mis vehiculos</h2>
              <p class="panel-subtitle">Aqui apareceran los vehiculos asociados a tu cuenta.</p>
            </div>
            <a class="secondary-button" href="#citas">Agendar cita</a>
          </div>

          <div class="panel-body">
            {vehiculos.length === 0 ? (
              <div class="empty-state">
                <strong>No tienes vehiculos registrados todavia.</strong>
                <span>Cuando el taller registre un vehiculo a tu nombre, aparecera aqui.</span>
              </div>
            ) : (
              <div class="vehicle-grid">
                {vehiculos.map((vehiculo) => (
                  <article class="vehicle-card">
                    <h3>{vehiculo.nombre}</h3>
                  </article>
                ))}
              </div>
            )}
          </div>
        </section>

        <section class="panel" id="ordenes">
          <div class="panel-header">
            <div>
              <h2 class="panel-title">Ordenes de servicio</h2>
              <p class="panel-subtitle">Aqui veras el estado de tus ordenes.</p>
            </div>
          </div>

          <div class="panel-body">
            {ordenes.length === 0 ? (
              <div class="empty-state">
                <strong>No tienes ordenes registradas.</strong>
                <span>Cuando el taller cree una orden para tu vehiculo, se mostrara en esta seccion.</span>
              </div>
            ) : (
              <div class="table-wrap">
                <table class="data-table">
                  <thead>
                    <tr>
                      <th>Orden</th>
                      <th>Vehiculo</th>
                      <th>Servicio</th>
                      <th>Fecha</th>
                      <th>Estado</th>
                      <th>Total</th>
                    </tr>
                  </thead>
                  <tbody>
                    {ordenes.map((orden) => (
                      <tr>
                        <td>{orden.id}</td>
                        <td>{orden.vehiculo}</td>
                        <td>{orden.servicio}</td>
                        <td>{orden.fecha}</td>
                        <td>{orden.estado}</td>
                        <td>{orden.total}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </div>
        </section>

        <section class="panel" id="pagos">
          <div class="panel-header">
            <div>
              <h2 class="panel-title">Pagos y facturas</h2>
              <p class="panel-subtitle">Aqui apareceran tus pagos y facturas.</p>
            </div>
          </div>

          <div class="panel-body">
            {pagos.length === 0 ? (
              <div class="empty-state">
                <strong>No tienes pagos registrados.</strong>
                <span>Cuando realices un pago o se genere una factura, aparecera aqui.</span>
              </div>
            ) : (
              <div class="table-wrap">
                <table class="data-table">
                  <thead>
                    <tr>
                      <th>Factura</th>
                      <th>Concepto</th>
                      <th>Fecha</th>
                      <th>Estado</th>
                      <th>Valor</th>
                    </tr>
                  </thead>
                  <tbody>
                    {pagos.map((pago) => (
                      <tr>
                        <td>{pago.factura}</td>
                        <td>{pago.concepto}</td>
                        <td>{pago.fecha}</td>
                        <td>{pago.estado}</td>
                        <td>{pago.valor}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </div>
        </section>
      </div>

      <aside class="page-grid">
        <section class="profile-card" id="perfil">
          <p class="eyebrow">Cuenta</p>
          <h2 class="panel-title">Mi perfil</h2>

          {cliente === null ? (
            <div class="empty-state">
              <strong>Informacion no cargada.</strong>
              <span>Cuando el login y el backend del cliente esten conectados, tus datos apareceran aqui.</span>
            </div>
          ) : (
            <dl>
              <div>
                <dt>Correo</dt>
                <dd>{cliente.correo}</dd>
              </div>
              <div>
                <dt>Telefono</dt>
                <dd>{cliente.telefono}</dd>
              </div>
              <div>
                <dt>Documento</dt>
                <dd>{cliente.documento}</dd>
              </div>
            </dl>
          )}
        </section>

        <section class="panel" id="citas">
          <div class="panel-header">
            <div>
              <h2 class="panel-title">Proximas citas</h2>
              <p class="panel-subtitle">Agenda y seguimiento.</p>
            </div>
          </div>

          <div class="panel-body">
            {citas.length === 0 ? (
              <div class="empty-state">
                <strong>No tienes citas programadas.</strong>
                <span>Cuando se agende una cita, aparecera en esta seccion.</span>
              </div>
            ) : (
              <div class="list-stack">
                {citas.map((cita) => (
                  <article class="list-item">
                    <strong>{cita.servicio}</strong>
                    <span>{cita.fecha} - {cita.hora}</span>
                    <span>Vehiculo {cita.vehiculo}</span>
                  </article>
                ))}
              </div>
            )}
          </div>
        </section>

        <section class="panel">
          <div class="panel-header">
            <div>
              <h2 class="panel-title">Recordatorios</h2>
              <p class="panel-subtitle">Mantenimiento recomendado.</p>
            </div>
          </div>

          <div class="panel-body">
            {recordatorios.length === 0 ? (
              <div class="empty-state">
                <strong>No tienes recordatorios activos.</strong>
                <span>Cuando tu vehiculo este cerca de un mantenimiento, lo veras aqui.</span>
              </div>
            ) : (
              <div class="list-stack">
                {recordatorios.map((recordatorio) => (
                  <article class="list-item">
                    <strong>{recordatorio}</strong>
                  </article>
                ))}
              </div>
            )}
          </div>
        </section>
      </aside>
    </div>
  </section>
</ClienteLayout>

<style>
  .empty-state {
    min-height: 120px;
    display: grid;
    align-content: center;
    gap: 8px;
    padding: 18px;
    border: 1px dashed #cbd5e1;
    border-radius: 8px;
    background: #f8fbff;
  }

  .empty-state strong {
    color: #1f2937;
  }

  .empty-state span {
    color: #64748b;
    line-height: 1.5;
  }
</style>