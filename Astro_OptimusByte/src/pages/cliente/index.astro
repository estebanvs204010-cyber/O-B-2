---
import ClienteLayout from "../../layouts/ClienteLayout.astro";
---

<ClienteLayout title="Panel del Cliente" active="inicio">
  <section id="inicio" class="summary-section">
    <h2>Resumen de tu cuenta</h2>

    <div class="summary-grid">
      <a class="summary-link" href="#vehiculos">
        <span>Vehículos registrados</span>
        <strong id="vehiculosCount">0</strong>
        <p>Ver los vehículos asociados a tu cuenta.</p>
        <span class="summary-action">Ver vehículos →</span>
      </a>

      <a class="summary-link" href="#ordenes">
        <span>Órdenes de servicio</span>
        <strong id="ordenesCount">0</strong>
        <p>Consultar el estado de tus servicios.</p>
        <span class="summary-action">Ver órdenes →</span>
      </a>

      <a class="summary-link" href="#citas">
        <span>Citas programadas</span>
        <strong id="citasCount">0</strong>
        <p>Revisar tus próximas visitas.</p>
        <span class="summary-action">Ver citas →</span>
      </a>

      <a class="summary-link" href="#pagos">
        <span>Pagos registrados</span>
        <strong id="pagosCount">0</strong>
        <p>Consultar facturas y pagos.</p>
        <span class="summary-action">Ver pagos →</span>
      </a>
    </div>
  </section>

  <div class="content-grid">
    <section id="perfil" class="panel client-section">
      <div class="panel-heading-row">
        <div>
          <h2>Mi perfil</h2>
          <p>Actualiza tus datos de contacto.</p>
        </div>

        <button id="editarPerfilButton" class="btn btn-outline" type="button">
          Editar perfil
        </button>
      </div>

      <div id="perfilMensaje" class="alert" hidden></div>

      <div id="perfilDatos">
        <p>
          <strong>Nombre:</strong>
          <span id="perfilNombre">Cargando...</span>
        </p>

        <p>
          <strong>Correo:</strong>
          <span id="perfilCorreo">Cargando...</span>
        </p>

        <p>
          <strong>Teléfono:</strong>
          <span id="perfilTelefono">Cargando...</span>
        </p>

        <p>
          <strong>Documento:</strong>
          <span id="perfilDocumento">Cargando...</span>
        </p>

        <p>
          <strong>Dirección:</strong>
          <span id="perfilDireccion">Cargando...</span>
        </p>
      </div>

      <form id="perfilForm" class="form-grid" hidden>
        <div class="field">
          <label for="nombreCompleto">Nombre completo</label>
          <input id="nombreCompleto" name="nombre_completo" required />
        </div>

        <div class="field">
          <label for="correo">Correo</label>
          <input id="correo" name="correo" type="email" required />
        </div>

        <div class="field">
          <label for="telefono">Teléfono</label>
          <input id="telefono" name="telefono" />
        </div>

        <div class="field">
          <label for="direccion">Dirección</label>
          <input id="direccion" name="direccion" />
        </div>

        <div class="field">
          <label for="documento">Documento</label>
          <input id="documento" disabled />
          <small>El documento no se puede modificar.</small>
        </div>

        <div class="form-actions">
          <button class="btn btn-primary" type="submit">
            Guardar cambios
          </button>

          <button id="cancelarPerfilButton" class="btn btn-outline" type="button">
            Cancelar
          </button>
        </div>
      </form>

      <div class="password-section">
        <h3>Contraseña</h3>
        <p>Recibirás un enlace de verificación en tu correo.</p>

        <button id="cambiarPasswordButton" class="btn btn-outline" type="button">
          Cambiar contraseña por correo
        </button>
      </div>
    </section>

    <section id="citas" class="panel client-section">
      <h2>Próximas citas</h2>

      <div class="empty-state">
        <p>No tienes citas programadas.</p>
      </div>
    </section>
  </div>

  <section id="vehiculos" class="panel client-section">
    <div class="panel-heading-row">
      <div>
        <h2>Mis vehículos</h2>
        <p>Consulta o registra los vehículos asociados a tu cuenta.</p>
      </div>

      <div class="vehicle-actions">
        <button id="verVehiculosButton" class="btn btn-outline" type="button">
          Ver vehículos
        </button>

        <button id="registrarVehiculoButton" class="btn btn-primary" type="button">
          Registrar vehículo
        </button>
      </div>
    </div>

    <div id="vehiculosMensaje" class="alert" hidden></div>

    <div id="vehicleList" class="orden-list">
      <p class="empty-state">Cargando vehículos...</p>
    </div>

    <form id="vehicleForm" class="vehicle-form form-grid" hidden>
      <h3>Registrar vehículo</h3>

      <div class="field">
        <label for="placa">Placa</label>
        <input id="placa" name="placa" required />
      </div>

      <div class="field">
        <label for="marca">Marca</label>
        <input id="marca" name="marca" required />
      </div>

      <div class="field">
        <label for="modelo">Modelo</label>
        <input id="modelo" name="modelo" required />
      </div>

      <div class="field">
        <label for="anio">Año</label>
        <input
          id="anio"
          name="anio"
          type="number"
          min="1900"
          max="2100"
          required
        />
      </div>

      <div class="field">
        <label for="kmActuales">Kilómetros actuales</label>
        <input
          id="kmActuales"
          name="km_actuales"
          type="number"
          min="0"
          value="0"
          required
        />
      </div>

      <div class="form-actions">
        <button class="btn btn-primary" type="submit">
          Guardar vehículo
        </button>

        <button
          id="cancelarVehiculoButton"
          class="btn btn-outline"
          type="button"
        >
          Cancelar
        </button>
      </div>
    </form>
  </section>

  <section id="ordenes" class="panel client-section">
    <h2>Órdenes de servicio</h2>

    <div class="empty-state">
      <p>No tienes órdenes de servicio registradas.</p>
    </div>
  </section>

  <section id="pagos" class="panel client-section">
    <h2>Pagos y facturas</h2>

    <div class="empty-state">
      <p>No tienes pagos registrados.</p>
    </div>
  </section>
</ClienteLayout>

<script>
  import { apiFetch } from "../../lib/api";

  interface PerfilCliente {
    id_usuario?: number;
    nombre_completo?: string;
    correo?: string;
    telefono?: string | null;
    direccion?: string | null;
    documento?: string | null;
    numero_documento?: string | null;
  }

  interface Vehiculo {
    id_vehiculo?: number;
    placa?: string;
    marca?: string;
    modelo?: string;
    anio?: number;
    km_actuales?: number;
  }

  const perfilMensaje = document.getElementById(
    "perfilMensaje",
  ) as HTMLDivElement;

  const perfilDatos = document.getElementById(
    "perfilDatos",
  ) as HTMLDivElement;

  const perfilForm = document.getElementById(
    "perfilForm",
  ) as HTMLFormElement;

  const editarPerfilButton = document.getElementById(
    "editarPerfilButton",
  ) as HTMLButtonElement;

  const cancelarPerfilButton = document.getElementById(
    "cancelarPerfilButton",
  ) as HTMLButtonElement;

  const cambiarPasswordButton = document.getElementById(
    "cambiarPasswordButton",
  ) as HTMLButtonElement;

  const vehiculosMensaje = document.getElementById(
    "vehiculosMensaje",
  ) as HTMLDivElement;

  const vehicleList = document.getElementById(
    "vehicleList",
  ) as HTMLDivElement;

  const vehicleForm = document.getElementById(
    "vehicleForm",
  ) as HTMLFormElement;

  const registrarVehiculoButton = document.getElementById(
    "registrarVehiculoButton",
  ) as HTMLButtonElement;

  const verVehiculosButton = document.getElementById(
    "verVehiculosButton",
  ) as HTMLButtonElement;

  const cancelarVehiculoButton = document.getElementById(
    "cancelarVehiculoButton",
  ) as HTMLButtonElement;

  let perfilActual: PerfilCliente | null = null;

  function mostrarMensaje(
    elemento: HTMLDivElement,
    mensaje: string,
    tipo: "success" | "error",
  ) {
    elemento.textContent = mensaje;
    elemento.hidden = false;
    elemento.className = `alert alert-${tipo}`;
  }

  function ocultarMensaje(elemento: HTMLDivElement) {
    elemento.hidden = true;
    elemento.textContent = "";
  }

  function mostrarValor(valor?: string | number | null): string {
    if (valor === undefined || valor === null || valor === "") {
      return "No registrado";
    }

    return String(valor);
  }

  function cargarDatosPerfil(perfil: PerfilCliente) {
    perfilActual = perfil;

    const nombre = document.getElementById("perfilNombre");
    const correo = document.getElementById("perfilCorreo");
    const telefono = document.getElementById("perfilTelefono");
    const documento = document.getElementById("perfilDocumento");
    const direccion = document.getElementById("perfilDireccion");

    if (nombre) {
      nombre.textContent = mostrarValor(perfil.nombre_completo);
    }

    if (correo) {
      correo.textContent = mostrarValor(perfil.correo);
    }

    if (telefono) {
      telefono.textContent = mostrarValor(perfil.telefono);
    }

    if (direccion) {
      direccion.textContent = mostrarValor(perfil.direccion);
    }

    if (documento) {
      documento.textContent = mostrarValor(
        perfil.documento ?? perfil.numero_documento,
      );
    }

    const nombreInput = document.getElementById(
      "nombreCompleto",
    ) as HTMLInputElement;

    const correoInput = document.getElementById(
      "correo",
    ) as HTMLInputElement;

    const telefonoInput = document.getElementById(
      "telefono",
    ) as HTMLInputElement;

    const direccionInput = document.getElementById(
      "direccion",
    ) as HTMLInputElement;

    const documentoInput = document.getElementById(
      "documento",
    ) as HTMLInputElement;

    nombreInput.value = perfil.nombre_completo ?? "";
    correoInput.value = perfil.correo ?? "";
    telefonoInput.value = perfil.telefono ?? "";
    direccionInput.value = perfil.direccion ?? "";

    documentoInput.value = mostrarValor(
      perfil.documento ?? perfil.numero_documento,
    );
  }

  function renderVehiculos(vehiculos: Vehiculo[]) {
    const count = document.getElementById("vehiculosCount");

    if (count) {
      count.textContent = String(vehiculos.length);
    }

    if (vehiculos.length === 0) {
      vehicleList.innerHTML = `
        <div class="empty-state">
          <p>No tienes vehículos registrados actualmente.</p>
        </div>
      `;
      return;
    }

    vehicleList.innerHTML = vehiculos
      .map(
        (vehiculo) => `
          <article class="orden-row">
            <div>
              <strong>${vehiculo.placa ?? "Sin placa"}</strong>
              <div class="sub">Placa</div>
            </div>

            <div>
              <strong>${vehiculo.marca ?? "Sin marca"}</strong>
              <div class="sub">${vehiculo.modelo ?? "Sin modelo"}</div>
            </div>

            <div>
              <strong>Año: ${vehiculo.anio ?? "-"}</strong>
              <div class="sub">
                ${vehiculo.km_actuales ?? 0} km actuales
              </div>
            </div>
          </article>
        `,
      )
      .join("");
  }

  async function cargarPerfil() {
    try {
      const resultado = await apiFetch<PerfilCliente>(
        "/api/cliente/me",
      );

      cargarDatosPerfil(resultado.data ?? {});
    } catch (error) {
      perfilDatos.innerHTML = `
        <div class="empty-state">
          <p>No se pudo cargar la información del perfil.</p>
        </div>
      `;

      mostrarMensaje(
        perfilMensaje,
        error instanceof Error
          ? error.message
          : "Error cargando el perfil",
        "error",
      );
    }
  }

  async function cargarVehiculos() {
    try {
      const resultado = await apiFetch<Vehiculo[]>(
        "/api/cliente/mis-vehiculos",
      );

      renderVehiculos(resultado.data ?? []);
    } catch (error) {
      vehicleList.innerHTML = `
        <div class="empty-state">
          <p>No se pudieron cargar los vehículos.</p>
        </div>
      `;

      mostrarMensaje(
        vehiculosMensaje,
        error instanceof Error
          ? error.message
          : "Error cargando los vehículos",
        "error",
      );
    }
  }

  editarPerfilButton.addEventListener("click", () => {
    perfilDatos.hidden = true;
    perfilForm.hidden = false;
    editarPerfilButton.hidden = true;
  });

  cancelarPerfilButton.addEventListener("click", () => {
    perfilForm.hidden = true;
    perfilDatos.hidden = false;
    editarPerfilButton.hidden = false;

    ocultarMensaje(perfilMensaje);

    if (perfilActual) {
      cargarDatosPerfil(perfilActual);
    }
  });

  perfilForm.addEventListener("submit", async (event) => {
    event.preventDefault();

    ocultarMensaje(perfilMensaje);

    const datos = new FormData(perfilForm);

    const body = {
      nombre_completo: String(
        datos.get("nombre_completo") ?? "",
      ).trim(),

      correo: String(
        datos.get("correo") ?? "",
      ).trim(),

      telefono: String(
        datos.get("telefono") ?? "",
      ).trim(),

      direccion: String(
        datos.get("direccion") ?? "",
      ).trim(),
    };

    try {
      const resultado = await apiFetch<PerfilCliente>(
        "/api/cliente/me",
        {
          method: "PUT",
          body: JSON.stringify(body),
        },
      );

      cargarDatosPerfil(resultado.data ?? body);

      perfilForm.hidden = true;
      perfilDatos.hidden = false;
      editarPerfilButton.hidden = false;

      mostrarMensaje(
        perfilMensaje,
        resultado.message ?? "Perfil actualizado correctamente.",
        "success",
      );
    } catch (error) {
      mostrarMensaje(
        perfilMensaje,
        error instanceof Error
          ? error.message
          : "No se pudo actualizar el perfil.",
        "error",
      );
    }
  });

  cambiarPasswordButton.addEventListener("click", async () => {
    cambiarPasswordButton.disabled = true;
    ocultarMensaje(perfilMensaje);

    try {
      const resultado = await apiFetch(
        "/api/auth/solicitar-recuperacion",
        {
          method: "POST",
          body: JSON.stringify({
            correo: perfilActual?.correo ?? "",
          }),
        },
      );

      mostrarMensaje(
        perfilMensaje,
        resultado.message ??
          "Revisa tu correo para cambiar la contraseña.",
        "success",
      );
    } catch (error) {
      mostrarMensaje(
        perfilMensaje,
        error instanceof Error
          ? error.message
          : "No se pudo solicitar el cambio de contraseña.",
        "error",
      );
    } finally {
      cambiarPasswordButton.disabled = false;
    }
  });

  registrarVehiculoButton.addEventListener("click", () => {
    vehicleForm.hidden = false;
    registrarVehiculoButton.hidden = true;
  });

  verVehiculosButton.addEventListener("click", () => {
    vehicleList.scrollIntoView({
      behavior: "smooth",
      block: "center",
    });
  });

  cancelarVehiculoButton.addEventListener("click", () => {
    vehicleForm.reset();
    vehicleForm.hidden = true;
    registrarVehiculoButton.hidden = false;

    ocultarMensaje(vehiculosMensaje);
  });

  vehicleForm.addEventListener("submit", async (event) => {
    event.preventDefault();

    ocultarMensaje(vehiculosMensaje);

    const datos = new FormData(vehicleForm);

    const body = {
      placa: String(datos.get("placa") ?? "").trim(),
      marca: String(datos.get("marca") ?? "").trim(),
      modelo: String(datos.get("modelo") ?? "").trim(),
      anio: Number(datos.get("anio")),
      km_actuales: Number(datos.get("km_actuales") ?? 0),
    };

    try {
      const resultado = await apiFetch(
        "/api/cliente/mis-vehiculos",
        {
          method: "POST",
          body: JSON.stringify(body),
        },
      );

      vehicleForm.reset();
      vehicleForm.hidden = true;
      registrarVehiculoButton.hidden = false;

      mostrarMensaje(
        vehiculosMensaje,
        resultado.message ??
          "Vehículo registrado correctamente.",
        "success",
      );

      await cargarVehiculos();
    } catch (error) {
      mostrarMensaje(
        vehiculosMensaje,
        error instanceof Error
          ? error.message
          : "No se pudo registrar el vehículo.",
        "error",
      );
    }
  });

  await cargarPerfil();
  await cargarVehiculos();
</script>