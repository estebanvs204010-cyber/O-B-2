    width: min(820px, 100%);
    justify-self: center;
    box-sizing: border-box;
  }

  .dashboard-right {
    grid-column: 2;
    grid-row: 1;
    display: block;
    min-width: 0;
  }

  .dashboard-right .card {
    height: 100%;
    box-sizing: border-box;
  }

  .summary-grid {
    flex: 1;
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    justify-items: center;
    gap: 20px;
  }

  .summary-grid .summary-link {
    display: grid;
    grid-template-rows: auto auto minmax(58px, 1fr) auto;
    align-content: start;
    align-items: start;
    width: 100%;
    max-width: 390px;
    min-height: 255px;
    box-sizing: border-box;
  }

  .summary-grid .summary-link h3 {
    min-height: 28px;
    margin: 0 0 18px;
  }

  .summary-grid .summary-link strong {
    display: block;
    min-height: 42px;
  }

  .summary-grid .summary-link p {
    min-height: 58px;
    margin: 0 0 18px;
  }

  .summary-grid .summary-link .summary-action {
    align-self: end;
    margin-top: auto;
  }

  @media (max-width: 1000px) {
    .client-dashboard {
      width: calc(100% - 24px);
      margin: 24px auto;
      grid-template-columns: 1fr;
    }

    .dashboard-left {
      display: grid;
      gap: 24px;
    }

    .dashboard-left > .summary-panel,
    .dashboard-left > #vehiculos,
    .dashboard-right {
      grid-column: auto;
      grid-row: auto;
    }

    .dashboard-left > #vehiculos {
      width: 100%;
    }

    .dashboard-right .card {
      height: auto;
    }
  }

  @media (max-width: 700px) {
    .summary-grid {
      grid-template-columns: 1fr;
      padding: 16px 0;
    }

    .summary-grid .summary-link {
      max-width: 100%;
      min-height: auto;
    }
  }
</style>
