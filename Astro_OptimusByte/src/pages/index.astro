---
import PublicLayout from '../layouts/PublicLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Icon from '../components/Icon.astro';
import { TALLER, servicios, pasos, repuestos, promos, articulos } from '../data/taller';

const serviciosHome = servicios.slice(0, 4);
const articulosHome = articulos.slice(0, 3);
const fechaLarga = (iso: string) =>
  new Date(iso + 'T12:00:00').toLocaleDateString('es-CO', { day: 'numeric', month: 'long', year: 'numeric' });
---
<PublicLayout>
  <!-- ═════════ HERO ═════════ -->
  <section class="hm-hero">
    <div class="hm-wrap hm-hero-grid">
      <div>
        <p class="hm-eyebrow">Servicio automotriz especializado</p>
        <h1>Taller<br />mecánico<br /><span>OptimusByte</span></h1>
        <p class="hm-hero-lead">
          Mantenimiento, diagnóstico y reparación con seguimiento en línea de cada orden. Tu vehículo en manos expertas.
        </p>
        <div class="hm-hero-actions">
          <a href="/reservas" class="hm-btn">Reserva tu servicio</a>
          <a href="/login?next=/cliente/index" class="hm-btn hm-btn--ghost">Mi área de cliente</a>
        </div>
        <a href="/cliente" id="btnCliente" class="hm-hero-link">¿Ya eres cliente? Consulta el estado de tu orden →</a>
      </div>
      <div class="hm-hero-art">
        <img src="./img/carro.png" alt="Vehículo con vista interna del motor y la suspensión" width="760" height="400" />
      </div>
    </div>
  </section>

  <!-- ═════════ CIFRAS ═════════ -->
  <section class="hm-strip" aria-label="Datos del taller">
    <div class="hm-wrap hm-strip-grid">
      <div class="hm-strip-item"><strong>+<em>{TALLER.anosExperiencia}</em></strong><span>Años de experiencia</span></div>
      <div class="hm-strip-item"><strong>+<em>500</em></strong><span>Vehículos atendidos</span></div>
      <div class="hm-strip-item"><strong><em>100</em>%</strong><span>Seguimiento en línea</span></div>
      <div class="hm-strip-item"><strong><em>24</em>/7</strong><span>Consulta tu orden</span></div>
    </div>
  </section>

  <!-- ═════════ NOSOTROS ═════════ -->
  <section class="hm-section">
    <div class="hm-wrap hm-about-grid">
      <div class="hm-about-text" data-reveal>
        <div class="hm-section-head" style="margin-bottom:24px;">
          <p class="hm-eyebrow">Nosotros</p>
          <h2>Mecánica y colisión en un solo lugar</h2>
        </div>
        <p>
          En OptimusByte combinamos la experiencia de un taller tradicional con tecnología: cada vehículo
          tiene su historial, cada orden de trabajo su seguimiento y cada cliente la tranquilidad de saber
          en qué etapa va su servicio.
        </p>
        <p>
          Atendemos mecánica general, diagnóstico electrónico, latonería y pintura, y te ayudamos a conseguir
          los repuestos correctos para tu vehículo.
        </p>
        <a href="/nosotros" class="hm-btn hm-btn--ghost">Conócenos</a>
      </div>
      <div class="hm-about-card" data-reveal>
        <h3>¿Por qué elegirnos?</h3>
        <p>Transparencia desde la cotización hasta la entrega.</p>
        <ul>
          <li>Cotización clara antes de empezar</li>
          <li>Historial completo de tu vehículo</li>
          <li>Estado de tu orden en tiempo real</li>
          <li>Técnicos con experiencia certificada</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ═════════ SERVICIOS ═════════ -->
  <section class="hm-section hm-section--gray">
    <div class="hm-wrap">
      <div class="hm-section-head center" data-reveal>
        <p class="hm-eyebrow">Nuestros servicios</p>
        <h2>Todo para tu vehículo</h2>
        <p>Desde un cambio de aceite hasta una reparación completa de colisión.</p>
      </div>
      <div class="hm-cards">
        {serviciosHome.map((s, i) => (
          <article class="hm-card" data-reveal style={`transition-delay:${i * 0.07}s`}>
            <div class="hm-card-icon"><Icon name={s.icono} /></div>
            <h3>{s.titulo}</h3>
            <p>{s.texto}</p>
            <a href={`/servicios#${s.slug}`} class="hm-card-link">Ver más →</a>
          </article>
        ))}
      </div>
      <div class="hm-center-action" data-reveal>
        <a href="/servicios" class="hm-btn hm-btn--ghost">Ver todos los servicios</a>
      </div>
    </div>
  </section>

  <!-- ═════════ PROCESO ═════════ -->
  <section class="hm-section">
    <div class="hm-wrap">
      <div class="hm-section-head center" data-reveal>
        <p class="hm-eyebrow">Así trabajamos</p>
        <h2>Tres pasos y listo</h2>
      </div>
      <div class="hm-steps">
        {pasos.map((p, i) => (
          <div class="hm-step" data-reveal style={`transition-delay:${i * 0.1}s`}>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═════════ REPUESTOS ═════════ -->
  <section class="hm-section hm-section--gray">
    <div class="hm-wrap">
      <div class="hm-section-head center" data-reveal>
        <p class="hm-eyebrow">Repuestos</p>
        <h2>Encuentra lo que necesitas</h2>
        <p>Repuestos y accesorios para mantener tu vehículo en óptimas condiciones.</p>
      </div>
      <div class="hm-parts">
        {repuestos.map((r, i) => (
          <a href="/repuestos" class="hm-part" data-reveal style={`transition-delay:${i * 0.05}s`}>
            <Icon name={r.icono} />
            {r.nombre}
          </a>
        ))}
      </div>
      <div class="hm-stock-preview">
        <div class="hm-stock-heading">
          <h3>Repuestos disponibles</h3>
          <a href="/repuestos">Ver tienda y comprar →</a>
        </div>
        <div id="homeRepuestos" class="hm-stock-grid" aria-live="polite">
          <p class="hm-stock-message">Consultando inventario…</p>
        </div>
        <div class="hm-home-cart">
          <div class="hm-stock-heading">
            <div>
              <h3>Tu carrito</h3>
              <p id="homeCartCount">0 productos</p>
            </div>
            <strong id="homeCartTotal">$0</strong>
          </div>
          <div id="homeCartItems" class="hm-home-cart-items">
            <p class="hm-stock-message">Agrega repuestos para comenzar.</p>
          </div>
          <form id="homeCheckout" class="hm-home-checkout">
            <label for="homePayment">Método de pago</label>
            <select id="homePayment" name="metodo_pago">
              <option value="Pago en taller">Pago en el taller</option>
              <option value="Transferencia">Transferencia</option>
            </select>
            <label for="homeNotes">Observaciones (opcional)</label>
            <textarea id="homeNotes" name="observaciones" rows="2" maxlength="300"></textarea>
            <button id="homeCheckoutButton" class="hm-btn hm-btn--blue" type="submit" disabled>Confirmar pedido</button>
            <p id="homeShopMessage" class="hm-stock-message" role="status">Confirma tu pedido con tu cuenta de cliente.</p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- ═════════ COTIZACIÓN ═════════ -->
  <QuoteForm id="cotizar" />

  <!-- ═════════ PROMOCIONES ═════════ -->
  <section class="hm-section">
    <div class="hm-wrap">
      <div class="hm-section-head center" data-reveal>
        <p class="hm-eyebrow">Promociones</p>
        <h2>Revisiones que te ahorran sustos</h2>
      </div>
      <div class="hm-promos">
        {promos.map((p, i) => (
          <article class="hm-promo" data-reveal style={`transition-delay:${i * 0.08}s`}>
            <span class="hm-promo-tag">{p.etiqueta}</span>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
            <div class="hm-promo-price"><small>Desde</small>{p.precio}</div>
            <a href="/reservas" class="hm-btn hm-btn--sm">Reservar</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═════════ BLOG ═════════ -->
  <section class="hm-section hm-section--gray">
    <div class="hm-wrap">
      <div class="hm-section-head center" data-reveal>
        <p class="hm-eyebrow">Blog</p>
        <h2>Consejos para tu vehículo</h2>
      </div>
      <div class="hm-posts">
        {articulosHome.map((a, i) => (
          <a href={`/blog#${a.slug}`} class="hm-post" data-reveal style={`transition-delay:${i * 0.08}s`}>
            <div class="hm-post-cover"><Icon name={a.icono} /></div>
            <div class="hm-post-body">
              <span class="hm-post-meta">{a.categoria} · {fechaLarga(a.fecha)}</span>
              <h3>{a.titulo}</h3>
              <p>{a.resumen}</p>
            </div>
          </a>
        ))}
      </div>
      <div class="hm-center-action" data-reveal>
        <a href="/blog" class="hm-btn hm-btn--ghost">Ver todos los artículos</a>
      </div>
    </div>
  </section>

  <!-- ═════════ CTA FINAL ═════════ -->
  <section class="hm-cta">
    <div class="hm-wrap" data-reveal>
      <h2>¿Listo para cuidar tu vehículo?</h2>
      <p>Crea tu cuenta, registra tu vehículo y sigue cada servicio en línea.</p>
      <a href="/registro" class="hm-btn hm-btn--light" id="btnCtaRegistro">Crear cuenta gratis</a>
    </div>
  </section>
</PublicLayout>

<script>
  interface RepuestoCatalogo {
    id_repuesto: number;
    nombre: string;
    categoria?: string | null;
    precio_unitario: number | string;
    stock_actual: number | string;
    imagen_url?: string | null;
  }

  const grid = document.getElementById("homeRepuestos");
  const moneda = new Intl.NumberFormat("es-CO", {
    style: "currency",
    currency: "COP",
    maximumFractionDigits: 0,
  });
  const carrito = new Map<number, number>();
  let repuestosDisponibles: RepuestoCatalogo[] = [];

  function renderCarrito() {
    const items = document.getElementById("homeCartItems");
    const cantidad = document.getElementById("homeCartCount");
    const totalElemento = document.getElementById("homeCartTotal");
    const confirmar = document.getElementById("homeCheckoutButton") as HTMLButtonElement | null;
    if (!items || !cantidad || !totalElemento || !confirmar) return;

    items.replaceChildren();
    let unidades = 0;
    let total = 0;
    carrito.forEach((cuantas, id) => {
      const repuesto = repuestosDisponibles.find((item) => item.id_repuesto === id);
      if (!repuesto) return;
      unidades += cuantas;
      total += Number(repuesto.precio_unitario) * cuantas;
      const fila = document.createElement("div");
      fila.className = "hm-home-cart-row";
      const nombre = document.createElement("span");
      nombre.textContent = `${repuesto.nombre} × ${cuantas}`;
      const subtotal = document.createElement("strong");
      subtotal.textContent = moneda.format(Number(repuesto.precio_unitario) * cuantas);
      const quitar = document.createElement("button");
      quitar.type = "button";
      quitar.dataset.removeId = String(id);
      quitar.textContent = "Quitar";
      fila.append(nombre, subtotal, quitar);
      items.append(fila);
    });
    if (!unidades) {
      const vacio = document.createElement("p");
      vacio.className = "hm-stock-message";
      vacio.textContent = "Agrega repuestos para comenzar.";
      items.append(vacio);
    }
    cantidad.textContent = `${unidades} producto${unidades === 1 ? "" : "s"}`;
    totalElemento.textContent = moneda.format(total);
    confirmar.disabled = unidades === 0;
    grid?.querySelectorAll<HTMLButtonElement>("button[data-add-id]").forEach((boton) => {
      const id = Number(boton.dataset.addId);
      const item = repuestosDisponibles.find((repuesto) => repuesto.id_repuesto === id);
      boton.disabled = !item || (carrito.get(id) ?? 0) >= Math.min(Number(item.stock_actual), 50);
    });
    sessionStorage.setItem("optimusbyte-repuestos-home-carrito", JSON.stringify([...carrito]));
  }

  async function cargarRepuestos() {
    if (!grid) return;
    try {
      const respuesta = await fetch("/api/repuestos");
      if (!respuesta.ok) throw new Error(`Error ${respuesta.status}`);
      const resultado = await respuesta.json();
      if (!resultado.success || !Array.isArray(resultado.data)) {
        throw new Error("No se recibió el catálogo de repuestos.");
      }

      const disponibles = (resultado.data as RepuestoCatalogo[])
        .filter((item) => Number(item.stock_actual) > 0)
        .slice(0, 4);
      repuestosDisponibles = disponibles;
      const carritoGuardado = sessionStorage.getItem("optimusbyte-repuestos-home-carrito");
      if (carritoGuardado) {
        try {
          const guardados: [number, number][] = JSON.parse(carritoGuardado);
          guardados.forEach(([id, cantidad]) => {
            const item = repuestosDisponibles.find((repuesto) => repuesto.id_repuesto === id);
            if (item && Number.isInteger(cantidad) && cantidad > 0) {
              carrito.set(id, Math.min(cantidad, Number(item.stock_actual), 50));
            }
          });
        } catch {
          sessionStorage.removeItem("optimusbyte-repuestos-home-carrito");
        }
      }
      grid.replaceChildren();
      if (!disponibles.length) {
        const vacio = document.createElement("p");
        vacio.className = "hm-stock-message";
        vacio.textContent = "No hay repuestos disponibles en este momento.";
        grid.append(vacio);
        return;
      }

      disponibles.forEach((item) => {
        const tarjeta = document.createElement("article");
        tarjeta.className = "hm-stock-card";
        if (item.imagen_url) {
          const imagen = document.createElement("img");
          imagen.src = item.imagen_url;
          imagen.alt = item.nombre;
          imagen.loading = "lazy";
          imagen.addEventListener("error", () => imagen.remove());
          tarjeta.append(imagen);
        }

        const categoria = document.createElement("small");
        categoria.textContent = item.categoria || "Repuesto";
        const nombre = document.createElement("strong");
        nombre.textContent = item.nombre;
        const precio = document.createElement("span");
        precio.textContent = moneda.format(Number(item.precio_unitario));
        tarjeta.append(categoria, nombre, precio);
        const agregar = document.createElement("button");
        agregar.type = "button";
        agregar.className = "hm-home-add";
        agregar.dataset.addId = String(item.id_repuesto);
        agregar.textContent = "Agregar al carrito";
        agregar.disabled = (carrito.get(item.id_repuesto) ?? 0) >= Math.min(Number(item.stock_actual), 50);
        tarjeta.append(agregar);
        grid.append(tarjeta);
      });
      renderCarrito();
    } catch (errorCarga) {
      console.error("No se pudo cargar el inventario en la página principal:", errorCarga);
      const mensajeError = document.createElement("p");
      mensajeError.className = "hm-stock-message";
      mensajeError.textContent = "No se pudo cargar el inventario. Intenta nuevamente más tarde.";
      grid.replaceChildren(mensajeError);
    }
  }

  grid?.addEventListener("click", (event) => {
    const boton = (event.target as HTMLElement).closest<HTMLButtonElement>("button[data-add-id]");
    if (!boton) return;
    const id = Number(boton.dataset.addId);
    const item = repuestosDisponibles.find((repuesto) => repuesto.id_repuesto === id);
    if (!item) return;
    carrito.set(id, Math.min((carrito.get(id) ?? 0) + 1, Number(item.stock_actual), 50));
    renderCarrito();
  });

  document.getElementById("homeCartItems")?.addEventListener("click", (event) => {
    const boton = (event.target as HTMLElement).closest<HTMLButtonElement>("button[data-remove-id]");
    if (!boton) return;
    carrito.delete(Number(boton.dataset.removeId));
    renderCarrito();
  });

  document.getElementById("homeCheckout")?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!carrito.size) return;
    const boton = document.getElementById("homeCheckoutButton") as HTMLButtonElement;
    const mensaje = document.getElementById("homeShopMessage")!;
    boton.disabled = true;
    boton.textContent = "Confirmando…";
    const form = event.currentTarget as HTMLFormElement;
    const datos = new FormData(form);
    try {
      const respuesta = await fetch("/api/cliente/pedidos", {
        method: "POST",
        credentials: "include",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          items: [...carrito].map(([id_repuesto, cantidad]) => ({ id_repuesto, cantidad })),
          metodo_pago: datos.get("metodo_pago"),
          observaciones: datos.get("observaciones"),
        }),
      });
      const resultado = await respuesta.json();
      if (respuesta.status === 401) {
        window.location.href = "/login?next=%2F";
        return;
      }
      if (!respuesta.ok || !resultado.success) throw new Error(resultado.message ?? "No se pudo registrar el pedido.");
      carrito.clear();
      sessionStorage.removeItem("optimusbyte-repuestos-home-carrito");
      form.reset();
      mensaje.className = "hm-stock-message hm-shop-success";
      mensaje.textContent = resultado.message ?? "Pedido registrado correctamente.";
      await cargarRepuestos();
    } catch (error) {
      console.error("No se pudo confirmar el pedido de repuestos:", error);
      mensaje.className = "hm-stock-message hm-shop-error";
      mensaje.textContent = error instanceof Error ? error.message : "No se pudo confirmar el pedido.";
    } finally {
      boton.textContent = "Confirmar pedido";
      boton.disabled = carrito.size === 0;
    }
  });

  void cargarRepuestos();
</script>

<style is:global>
  .hm .hm-stock-preview {
    margin-top: 34px;
    padding: 24px;
    border: 1px solid #dce5ef;
    border-radius: 16px;
    background: #fff;
  }

  .hm .hm-stock-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 16px;
  }

  .hm .hm-stock-heading h3 { margin: 0; color: #142b49; }
  .hm .hm-stock-heading a { color: #1769d2; font-weight: 700; }
  .hm .hm-stock-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  .hm .hm-stock-card { min-width: 0; display: grid; align-content: start; gap: 7px; padding: 14px; border: 1px solid #e1e8f0; border-radius: 12px; color: #142b49; }
  .hm .hm-stock-card img { display: block; width: 100%; max-width: 100%; height: 110px; max-height: 110px; object-fit: contain; }
  .hm .hm-stock-card small { color: #60748b; }
  .hm .hm-stock-card strong { font-size: 14px; }
  .hm .hm-stock-card span { color: #1769d2; font-weight: 700; }
  .hm .hm-home-add { padding: 8px 10px; border: 0; border-radius: 7px; background: #1769d2; color: white; cursor: pointer; font: inherit; font-size: 12px; font-weight: 700; }
  .hm .hm-home-add:disabled { opacity: .55; cursor: not-allowed; }
  .hm .hm-stock-message { grid-column: 1 / -1; margin: 0; color: #60748b; text-align: center; }
  .hm .hm-home-cart { margin-top: 18px; padding: 18px; border: 1px solid #e1e8f0; border-radius: 12px; background: #f8fafc; }
  .hm .hm-home-cart .hm-stock-heading { margin-bottom: 12px; }
  .hm .hm-home-cart .hm-stock-heading p { margin: 4px 0 0; color: #60748b; font-size: 13px; }
  .hm .hm-home-cart-items { display: grid; gap: 8px; }
  .hm .hm-home-cart-row { display: flex; align-items: center; gap: 12px; padding: 9px 0; border-bottom: 1px solid #e1e8f0; color: #142b49; font-size: 13px; }
  .hm .hm-home-cart-row strong { margin-left: auto; }
  .hm .hm-home-cart-row button { border: 0; background: transparent; color: #b42318; cursor: pointer; font: inherit; font-size: 12px; }
  .hm .hm-home-checkout { display: grid; grid-template-columns: 1fr 1fr auto; align-items: end; gap: 10px; margin-top: 14px; }
  .hm .hm-home-checkout label { display: grid; gap: 5px; color: #142b49; font-size: 12px; font-weight: 600; }
  .hm .hm-home-checkout select, .hm .hm-home-checkout textarea { width: 100%; min-height: 40px; padding: 8px; border: 1px solid #d7e0eb; border-radius: 7px; background: white; color: #142b49; font: inherit; }
  .hm .hm-home-checkout textarea { resize: vertical; }
  .hm .hm-home-checkout .hm-stock-message { grid-column: 1 / -1; text-align: left; }
  .hm .hm-home-checkout button:disabled { opacity: .55; cursor: not-allowed; }
  .hm .hm-shop-success { color: #16703d; }
  .hm .hm-shop-error { color: #b42318; }

  @media (max-width: 800px) {
    .hm .hm-stock-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 520px) {
    .hm .hm-stock-preview { padding: 16px; }
    .hm .hm-stock-heading { align-items: flex-start; flex-direction: column; }
    .hm .hm-stock-grid { grid-template-columns: 1fr; }
    .hm .hm-home-checkout { grid-template-columns: 1fr; }
  }
</style>
