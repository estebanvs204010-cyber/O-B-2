---
import AuthLayout from "../layouts/AuthLayout.astro";
---

<AuthLayout title="Recuperar contraseña">
  <p class="auth-sub">
    Escribe tu correo y te enviaremos un enlace para crear una contraseña nueva.
  </p>

  <div id="rec-alert" class="alert alert-error" hidden></div>

  <form id="rec-form">
    <div class="field">
      <label for="correo">Correo</label>
      <input id="correo" name="correo" type="email" placeholder="tucorreo@ejemplo.com" required />
    </div>

    <button id="rec-submit" class="btn btn-primary btn-block" type="submit">
      Enviar enlace
    </button>
  </form>

  <p class="auth-footer">
    <a href="/login">Volver al inicio de sesión</a>
  </p>
</AuthLayout>

<script>
  import { apiFetch } from "../lib/api";

  const form = document.getElementById("rec-form") as HTMLFormElement;
  const alertBox = document.getElementById("rec-alert") as HTMLDivElement;
  const submitBtn = document.getElementById("rec-submit") as HTMLButtonElement;

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    alertBox.setAttribute("hidden", "true");
    submitBtn.disabled = true;
    submitBtn.textContent = "Enviando…";

    const correo = (document.getElementById("correo") as HTMLInputElement).value.trim();

    try {
      const resultado = await apiFetch("/api/auth/solicitar-recuperacion", {
        method: "POST",
        body: JSON.stringify({ correo }),
      });

      alertBox.className = "alert alert-ok";
      alertBox.textContent = resultado.message ?? "Revisa tu correo";
      alertBox.removeAttribute("hidden");
      // El botón queda deshabilitado para no mandar varios correos seguidos.
    } catch (error) {
      alertBox.className = "alert alert-error";
      alertBox.textContent = error instanceof Error ? error.message : "No se pudo enviar el correo";
      alertBox.removeAttribute("hidden");
      submitBtn.disabled = false;
      submitBtn.textContent = "Enviar enlace";
    }
  });
</script>
