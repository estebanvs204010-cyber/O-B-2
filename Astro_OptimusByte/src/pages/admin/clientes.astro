---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Clientes" active="clientes">
  <section class="page-header">
    <div>
      <p class="eyebrow">Gestion de clientes</p>
      <h2>Clientes</h2>
      <span>Registra, edita y desactiva clientes del taller.</span>
    </div>

    <div class="clientes-actions">
      <button id="btnRecargar" class="btn btn-outline" type="button">
        Recargar
      </button>

      <button id="btnCrear" class="btn btn-primary" type="button">
        + Nuevo cliente
      </button>
    </div>
  </section>

  <section class="admin-panel clientes-grid-panel">
    <div class="clientes-toolbar">
      <input
        id="quickSearch"
        class="clientes-search"
        type="search"
        placeholder="Buscar por nombre, documento, telefono o correo"
      />
    </div>

    <div id="myGrid" class="clientes-grid"></div>
  </section>

  <dialog id="modalCliente" class="cliente-dialog">
    <form id="formCliente" class="cliente-form">
      <div class="modal-header">
        <div>
          <p class="eyebrow">Informacion del cliente</p>
          <h2 id="modalTitulo">Nuevo cliente</h2>
        </div>

        <button id="btnCerrarModal" class="modal-close" type="button">
          &#10005;
        </button>
      </div>

      <input id="editIdCliente" type="hidden" />
      <input id="formModo" type="hidden" value="crear" />

      <section id="grupoFotoCliente" class="cliente-photo-editor" hidden>
        <img
          id="vistaPreviaFotoCliente"
          class="cliente-photo-preview"
          alt="Foto actual del cliente"
          hidden
        />
        <div id="inicialesFotoCliente" class="cliente-photo-placeholder" aria-hidden="true">
          ?
        </div>
        <div class="cliente-photo-controls">
          <label for="editFotoCliente">Foto del cliente</label>
          <input
            id="editFotoCliente"
            class="cliente-photo-input"
            type="file"
            accept="image/jpeg,image/png,image/webp"
          />
          <small>JPG, PNG o WebP. Tamaño máximo: 5 MB.</small>
        </div>
      </section>

      <div class="field">
        <label for="editNombre">Nombre completo</label>
        <input id="editNombre" required />
      </div>

      <div class="field-row">
        <div class="field">
          <label for="editTipoDocumento">Tipo de documento</label>
          <select id="editTipoDocumento" required>
            <option value="CC">CC</option>
            <option value="CE">CE</option>
            <option value="NIT">NIT</option>
            <option value="Pasaporte">Pasaporte</option>
          </select>
        </div>

        <div class="field">
          <label for="editDocumento">Numero de documento</label>
          <input id="editDocumento" required />
        </div>
      </div>

      <div class="field-row">
        <div class="field">
          <label for="editTelefono">Telefono</label>
          <input id="editTelefono" type="tel" required />
        </div>

        <div class="field">
          <label for="editCorreo">Correo</label>
          <input id="editCorreo" type="email" required />
        </div>
      </div>

      <div class="field" id="grupoContrasena">
        <label for="editContrasena">Contraseña temporal</label>
        <input
        id="editContrasena"
       type="password"
       minlength="8"
       required
       />
      </div>

      <div class="field">
        <label for="editDireccion">Direccion</label>
        <input id="editDireccion" />
      </div>

      <div class="modal-actions">
        <button id="btnCancelarModal" class="btn btn-outline" type="button">
          Cancelar
        </button>

        <button id="btnGuardar" class="btn btn-primary" type="submit">
          Guardar cliente
        </button>
      </div>
    </form>
  </dialog>

  <script>
    import {
      createGrid,
      ModuleRegistry,
      AllCommunityModule,
      themeQuartz,
    } from "ag-grid-community";

    import type {
      GridApi,
      GridOptions,
      ICellRendererParams,
    } from "ag-grid-community";

    import { apiFetch } from "../../lib/api";
    import { notificarError, notificarExito } from "../../lib/toast";
    import { confirmarCambioEstado } from "../../lib/confirmar";
    import { abrirMenuAcciones } from "../../lib/menuAcciones";

    ModuleRegistry.registerModules([AllCommunityModule]);

    interface ClienteRow {
      id_cliente: number;
      nombre_completo: string;
      foto_url?: string | null;
      tipo_documento: string;
      num_documento: string;
      telefono: string;
      correo: string;
      direccion?: string;
      activo: number;
    }

    const temaOptimus = themeQuartz.withParams({
      accentColor: "#1e6dff",
      backgroundColor: "#ffffff",
      foregroundColor: "#102a50",
      borderColor: "#e2e8f0",
      borderRadius: 8,
      wrapperBorderRadius: 8,
      headerFontWeight: 700,
    });

    let gridApi: GridApi<ClienteRow>;
    const modal = document.getElementById("modalCliente") as HTMLDialogElement;
    const formulario = document.getElementById("formCliente") as HTMLFormElement;
    const inputFoto = document.getElementById("editFotoCliente") as HTMLInputElement;
    const vistaPreviaFoto = document.getElementById(
      "vistaPreviaFotoCliente",
    ) as HTMLImageElement;
    const inicialesFoto = document.getElementById("inicialesFotoCliente")!;
    const grupoFoto = document.getElementById("grupoFotoCliente")!;
    let urlPreviaFoto: string | null = null;

    function mostrarFoto(url: string | null | undefined, nombre: string) {
      inicialesFoto.textContent = nombre.trim().charAt(0).toLocaleUpperCase("es") || "?";
      vistaPreviaFoto.hidden = !url;
      inicialesFoto.hidden = Boolean(url);
      if (url) vistaPreviaFoto.src = url;
      else vistaPreviaFoto.removeAttribute("src");
    }

    vistaPreviaFoto.addEventListener("error", () => {
      vistaPreviaFoto.hidden = true;
      inicialesFoto.hidden = false;
    });

    function limpiarPreviaLocal() {
      if (urlPreviaFoto) URL.revokeObjectURL(urlPreviaFoto);
      urlPreviaFoto = null;
    }

    inputFoto.addEventListener("change", () => {
      limpiarPreviaLocal();
      const archivo = inputFoto.files?.[0];
      if (!archivo) return;

      if (!["image/jpeg", "image/png", "image/webp"].includes(archivo.type)) {
        inputFoto.value = "";
        notificarError("Selecciona una imagen JPG, PNG o WebP.");
        return;
      }
      if (archivo.size > 5 * 1024 * 1024) {
        inputFoto.value = "";
        notificarError("La imagen no puede superar los 5 MB.");
        return;
      }

      urlPreviaFoto = URL.createObjectURL(archivo);
      mostrarFoto(urlPreviaFoto, "");
    });

function accionesCellRenderer(
  params: ICellRendererParams<ClienteRow>,
) {
  const cliente = params.data;

  if (!cliente) {
    return document.createElement("div");
  }

  const contenedor = document.createElement("div");
  contenedor.className = "grid-actions";

  const menu = document.createElement("button");
  menu.className = "grid-action-button menu";
  menu.type = "button";
  menu.textContent = "⋮";
  menu.title = "Acciones del cliente";
  menu.setAttribute("aria-label", "Acciones del cliente");

  const activo = Number(cliente.activo) === 1;

  menu.addEventListener("click", () => {
    abrirMenuAcciones(menu, [
      {
        etiqueta: "Editar cliente",
        alSeleccionar: () => abrirModalEditar(cliente),
      },
      {
        etiqueta: activo ? "Desactivar cliente" : "Activar cliente",
        variante: activo ? "danger" : "success",
        alSeleccionar: () => {
          void cambiarEstadoCliente(cliente, !activo);
        },
      },
    ]);
  });

  contenedor.appendChild(menu);

  return contenedor;
}
    const gridOptions: GridOptions<ClienteRow> = {
      theme: temaOptimus,

      columnDefs: [
        {
          headerName: "Foto",
          width: 86,
          cellRenderer: (params: ICellRendererParams<ClienteRow>) => {
            const cliente = params.data;
            const contenedor = document.createElement("div");
            contenedor.className = "cliente-grid-photo-wrap";
            const imagen = document.createElement("img");
            imagen.className = "cliente-grid-photo";
            imagen.alt = cliente ? `Foto de ${cliente.nombre_completo}` : "";
            imagen.loading = "lazy";
            if (cliente?.foto_url) imagen.src = cliente.foto_url;
            else imagen.removeAttribute("src");
            imagen.hidden = !cliente?.foto_url;
            imagen.addEventListener("error", () => {
              imagen.hidden = true;
              inicial.textContent =
                cliente?.nombre_completo.trim().charAt(0).toLocaleUpperCase("es") || "?";
              inicial.hidden = false;
            });
            const inicial = document.createElement("span");
            inicial.className = "cliente-grid-photo-placeholder";
            inicial.textContent =
              cliente?.nombre_completo.trim().charAt(0).toLocaleUpperCase("es") || "?";
            inicial.hidden = Boolean(cliente?.foto_url);
            contenedor.append(imagen, inicial);
            return contenedor;
          },
          sortable: false,
          filter: false,
        },
        {
          field: "nombre_completo",
          headerName: "Cliente",
          flex: 2,
          filter: true,
          floatingFilter: true,
        },
        {
          headerName: "Documento",
          flex: 1.3,
          valueGetter: (params) =>
            `${params.data?.tipo_documento ?? ""} ${params.data?.num_documento ?? ""}`,
          filter: true,
        },
        {
          field: "telefono",
          headerName: "Telefono",
          flex: 1.1,
          filter: true,
        },
        {
          field: "correo",
          headerName: "Correo",
          flex: 2,
          filter: true,
        },
        {
        headerName: "Estado",
        width: 125,
        cellRenderer: (params: ICellRendererParams<ClienteRow>) => {
          const estado = document.createElement("span");
          const activo = Number(params.data?.activo) === 1;

          estado.className = activo
            ? "cliente-status active"
            : "cliente-status inactive";

          estado.textContent = activo ? "Activo" : "Inactivo";

          return estado;
        },
        sortable: true,
        filter: true,
      },
        {
          headerName: "Acciones",
          width: 180,
          cellRenderer: accionesCellRenderer,
          sortable: false,
          filter: false,
        },
      ],

      defaultColDef: {
        resizable: true,
        sortable: true,
      },

      rowData: [],
      pagination: true,
      paginationPageSize: 10,
      paginationPageSizeSelector: [10, 20, 50],

      onGridReady: (params) => {
        gridApi = params.api;
        cargarClientes();
      },
    };

    const gridDiv = document.querySelector<HTMLElement>("#myGrid");

    if (gridDiv) {
      createGrid(gridDiv, gridOptions);
    }

    async function cargarClientes() {
      try {
        const respuesta = await apiFetch<ClienteRow[]>(
  "/api/clientes?incluir_inactivos=true",
);

        gridApi?.setGridOption("rowData", respuesta.data ?? []);
      } catch (error) {
        notificarError(
         error instanceof Error
          ? error.message
             : "No se pudieron cargar los clientes.",
      );
      }
    }

    function abrirModalCrear() {
      formulario.reset();
      limpiarPreviaLocal();
      grupoFoto.hidden = true;
      mostrarFoto(null, "");

      (document.getElementById("formModo") as HTMLInputElement).value = "crear";
      (document.getElementById("editIdCliente") as HTMLInputElement).value = "";
      (document.getElementById("modalTitulo") as HTMLElement).textContent =
        "Nuevo cliente";
      (document.getElementById("btnGuardar") as HTMLButtonElement).textContent =
        "Crear cliente";
      (document.getElementById("grupoContrasena") as HTMLElement).style.display = "none";
      const inputContrasena = document.getElementById(
  "editContrasena",
      ) as HTMLInputElement;
      inputContrasena.required = false;
      inputContrasena.value = "";

      modal.showModal();
    }

    async function abrirModalEditar(cliente: ClienteRow) {
      try {
        const respuesta = await apiFetch<ClienteRow>(
          `/api/clientes/${cliente.id_cliente}`,
        );

        const detalle = respuesta.data;

        if (!detalle) {
          throw new Error("Cliente no encontrado");
        }

        formulario.reset();
        limpiarPreviaLocal();
        inputFoto.value = "";
        grupoFoto.hidden = false;
        mostrarFoto(detalle.foto_url, detalle.nombre_completo);
        (document.getElementById("formModo") as HTMLInputElement).value = "editar";
        (document.getElementById("editIdCliente") as HTMLInputElement).value =
          String(detalle.id_cliente);
        (document.getElementById("modalTitulo") as HTMLElement).textContent =
          "Editar cliente";
        (document.getElementById("btnGuardar") as HTMLButtonElement).textContent =
          "Guardar cambios";

        (document.getElementById("editNombre") as HTMLInputElement).value =
          detalle.nombre_completo;
        (document.getElementById("editTipoDocumento") as HTMLSelectElement).value =
          detalle.tipo_documento;
        (document.getElementById("editDocumento") as HTMLInputElement).value =
          detalle.num_documento;
        (document.getElementById("editTelefono") as HTMLInputElement).value =
          detalle.telefono;
        (document.getElementById("editCorreo") as HTMLInputElement).value =
          detalle.correo;
        (document.getElementById("editDireccion") as HTMLInputElement).value =
          detalle.direccion ?? "";
        (document.getElementById("grupoContrasena") as HTMLElement).style.display = "none";
        const inputContrasena = document.getElementById(
  "editContrasena",
        ) as HTMLInputElement;
        inputContrasena.required = false;
        inputContrasena.value = "";

        modal.showModal();
      } catch (error) {
        notificarError(
          error instanceof Error
            ? error.message
            : "No se pudo consultar el cliente.",
        );
      }
    }

    async function cambiarEstadoCliente(
  cliente: ClienteRow,
  activar: boolean,
) {
  const confirmado = await confirmarCambioEstado(
    cliente.nombre_completo,
    activar,
  );

  if (!confirmado) return;

  try {
    const respuesta = await apiFetch(
      `/api/clientes/${cliente.id_cliente}/estado`,
      {
        method: "PUT",
        body: JSON.stringify({ activo: activar }),
      },
    );

    notificarExito(
      respuesta.message ??
        `Cliente ${activar ? "activado" : "desactivado"} correctamente.`,
    );

    cargarClientes();
  } catch (error) {
    notificarError(
      error instanceof Error
        ? error.message
        : `No se pudo ${activar ? "activar" : "desactivar"} el cliente.`,
    );
  }
}

    formulario.addEventListener("submit", async (evento) => {
      evento.preventDefault();

      const modo = (document.getElementById("formModo") as HTMLInputElement).value;
      const id = (document.getElementById("editIdCliente") as HTMLInputElement).value;
      const botonGuardar = document.getElementById("btnGuardar") as HTMLButtonElement;

      const body: Record<string, string> = {
  nombre_completo: (
    document.getElementById("editNombre") as HTMLInputElement
  ).value.trim(),

  tipo_documento: (
    document.getElementById("editTipoDocumento") as HTMLSelectElement
  ).value,

  num_documento: (
    document.getElementById("editDocumento") as HTMLInputElement
  ).value.trim(),

  telefono: (
    document.getElementById("editTelefono") as HTMLInputElement
  ).value.trim(),

  correo: (
    document.getElementById("editCorreo") as HTMLInputElement
  ).value.trim(),

  direccion: (
    document.getElementById("editDireccion") as HTMLInputElement
  ).value.trim(),
};

if (modo === "crear") {
  body.contrasena = (
    document.getElementById("editContrasena") as HTMLInputElement
  ).value;
}

      botonGuardar.disabled = true;
      botonGuardar.textContent = "Guardando...";

      try {
        const archivoFoto = modo === "editar" ? inputFoto.files?.[0] : undefined;
        if (archivoFoto) {
          botonGuardar.textContent = "Subiendo foto...";
          body.foto_url = await subirFotoCliente(archivoFoto);
        }

        const respuesta = await apiFetch(
          modo === "crear" ? "/api/clientes" : `/api/clientes/${id}`,
          {
            method: modo === "crear" ? "POST" : "PUT",
            body: JSON.stringify(body),
          },
        );

        modal.close();
        notificarExito(respuesta.message ?? "Cliente guardado correctamente.",);
        cargarClientes();
      } catch (error) {
        notificarError(
        error instanceof Error
                ? error.message
            : "No se pudieron cargar los clientes.",
        );
      } finally {
        botonGuardar.disabled = false;
        botonGuardar.textContent =
          modo === "crear" ? "Crear cliente" : "Guardar cambios";
      }
    });

    async function subirFotoCliente(archivo: File): Promise<string> {
      const respuestaFirma = await apiFetch<{
        cloudName: string;
        apiKey: string;
        timestamp: number;
        folder: string;
        signature: string;
      }>("/api/uploads/firma?tipo=clientes");

      if (!respuestaFirma.data) {
        throw new Error("El servidor no devolvió los datos para subir la foto.");
      }

      const firma = respuestaFirma.data;
      const datos = new FormData();
      datos.append("file", archivo);
      datos.append("api_key", firma.apiKey);
      datos.append("timestamp", String(firma.timestamp));
      datos.append("folder", firma.folder);
      datos.append("signature", firma.signature);

      const respuestaCloudinary = await fetch(
        `https://api.cloudinary.com/v1_1/${encodeURIComponent(firma.cloudName)}/image/upload`,
        { method: "POST", body: datos },
      );
      const resultado = (await respuestaCloudinary.json()) as {
        secure_url?: string;
        error?: { message?: string };
      };

      if (!respuestaCloudinary.ok || !resultado.secure_url) {
        throw new Error(
          resultado.error?.message ?? "Cloudinary no pudo subir la imagen.",
        );
      }
      return resultado.secure_url;
    }

    (document.getElementById("btnCrear") as HTMLButtonElement).addEventListener(
      "click",
      abrirModalCrear,
    );

    (document.getElementById("btnRecargar") as HTMLButtonElement).addEventListener(
      "click",
      cargarClientes,
    );

    (document.getElementById("btnCerrarModal") as HTMLButtonElement).addEventListener(
      "click",
      () => modal.close(),
    );

    (document.getElementById("btnCancelarModal") as HTMLButtonElement).addEventListener(
      "click",
      () => {
        limpiarPreviaLocal();
        modal.close();
      },
    );

    modal.addEventListener("close", limpiarPreviaLocal);

    const buscador = document.getElementById("quickSearch") as HTMLInputElement;

    buscador.addEventListener("input", () => {
      gridApi?.setGridOption("quickFilterText", buscador.value);
    });
  </script>
</AdminLayout>