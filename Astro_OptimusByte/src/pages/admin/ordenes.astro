---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Órdenes" active="ordenes">
  <section class="admin-page-header">
    <div>
      <p class="eyebrow">Gestión del taller</p>
      <h2>Órdenes y citas</h2>
      <span>Revisa las solicitudes de los clientes y asigna un mecánico para aceptarlas.</span>
    </div>

    <div class="admin-page-actions">
      <button id="btnRecargarOrdenes" class="btn btn-outline" type="button">
        Recargar
      </button>
    </div>
  </section>

  <section class="ordenes-resumen" aria-label="Resumen de órdenes">
    <article class="ordenes-metrica">
      <span>Pendientes de asignar</span>
      <strong id="ordenesPendientes">—</strong>
    </article>
    <article class="ordenes-metrica">
      <span>En proceso</span>
      <strong id="ordenesEnProceso">—</strong>
    </article>
    <article class="ordenes-metrica">
      <span>Total de órdenes</span>
      <strong id="ordenesTotal">—</strong>
    </article>
  </section>

  <section class="admin-panel ordenes-panel">
    <div class="ordenes-toolbar">
      <label class="ordenes-search-label" for="buscarOrdenes">Buscar órdenes</label>
      <input
        id="buscarOrdenes"
        class="ordenes-search"
        type="search"
        placeholder="Orden, cliente, placa o vehículo"
      />
    </div>

    <div class="ordenes-tabs" role="tablist" aria-label="Filtrar órdenes">
      <button class="ordenes-tab active" type="button" data-filtro="Todas">Todas</button>
      <button class="ordenes-tab" type="button" data-filtro="Pendiente">Pendientes</button>
      <button class="ordenes-tab" type="button" data-filtro="En Proceso">En proceso</button>
      <button class="ordenes-tab" type="button" data-filtro="Otras">Otras</button>
    </div>

    <div id="ordenesContenido" class="ordenes-table-wrap" aria-live="polite">
      <p class="loading">Cargando órdenes…</p>
    </div>
  </section>

  <dialog id="modalAsignarOrden" class="orden-dialog">
    <form id="formAsignarOrden" class="orden-dialog-form">
      <div class="modal-header">
        <div>
          <p class="eyebrow">Aceptar solicitud</p>
          <h2>Asignar mecánico</h2>
        </div>
        <button id="btnCerrarAsignacion" class="modal-close" type="button" aria-label="Cerrar">
          &#10005;
        </button>
      </div>

      <p id="detalleAsignacion" class="orden-dialog-detail"></p>

      <div class="field">
        <label for="seleccionarMecanico">Mecánico disponible</label>
        <select id="seleccionarMecanico" required>
          <option value="">Selecciona un mecánico</option>
        </select>
      </div>

      <p class="orden-dialog-note">
        Al confirmar, la cita será aceptada y la orden pasará al panel del mecánico.
      </p>

      <div class="modal-actions">
        <button id="btnCancelarAsignacion" class="btn btn-outline" type="button">Cancelar</button>
        <button id="btnConfirmarAsignacion" class="btn btn-primary" type="submit">
          Aceptar y asignar
        </button>
      </div>
    </form>
  </dialog>

  <script>
    import { apiFetch, claseEstado, formatearFechaHora } from "../../lib/api";
    import { notificarError, notificarExito } from "../../lib/toast";

    interface OrdenAdmin {
      id_orden: number;
      estado: string;
      tipo_servicio: string;
      descripcion_problema: string | null;
      fecha_apertura: string;
      fecha_entrega_estimada: string | null;
      id_vehiculo: number;
      placa: string;
      marca: string;
      modelo: string;
      id_cliente: number;
      propietario: string;
      propietario_telefono: string | null;
      id_mecanico: number | null;
      mecanico: string | null;
    }

    interface Mecanico {
      id_usuario: number;
      nombre_completo: string;
      activo: number;
    }

    const contenido = document.getElementById("ordenesContenido")!;
    const modal = document.getElementById("modalAsignarOrden") as HTMLDialogElement;
    const selectorMecanico = document.getElementById("seleccionarMecanico") as HTMLSelectElement;
    const buscar = document.getElementById("buscarOrdenes") as HTMLInputElement;
    const botonesFiltro = document.querySelectorAll<HTMLButtonElement>(".ordenes-tab");
    const formulario = document.getElementById("formAsignarOrden") as HTMLFormElement;
    let ordenes: OrdenAdmin[] = [];
    let mecanicos: Mecanico[] = [];
    let filtroActual = "Todas";
    let ordenSeleccionada: OrdenAdmin | null = null;

    function crearCelda(texto: string, clase?: string): HTMLTableCellElement {
      const celda = document.createElement("td");
      celda.textContent = texto;
      if (clase) celda.className = clase;
      return celda;
    }

    function pintarOrdenes() {
      const consulta = buscar.value.trim().toLocaleLowerCase("es");
      const visibles = ordenes.filter((orden) => {
        const coincideFiltro =
          filtroActual === "Todas" ||
          (filtroActual === "Otras"
            ? orden.estado !== "Pendiente" && orden.estado !== "En Proceso"
            : orden.estado === filtroActual);
        const texto = [
          orden.id_orden,
          orden.propietario,
          orden.placa,
          orden.marca,
          orden.modelo,
          orden.tipo_servicio,
          orden.estado,
          orden.mecanico ?? "",
        ]
          .join(" ")
          .toLocaleLowerCase("es");
        return coincideFiltro && texto.includes(consulta);
      });

      contenido.replaceChildren();
      if (visibles.length === 0) {
        const vacio = document.createElement("p");
        vacio.className = "empty";
        vacio.textContent = ordenes.length
          ? "No hay órdenes que coincidan con este filtro."
          : "Todavía no hay órdenes registradas.";
        contenido.append(vacio);
        return;
      }

      const tabla = document.createElement("table");
      tabla.className = "ordenes-table";
      const encabezado = document.createElement("thead");
      const filaEncabezado = document.createElement("tr");
      ["Orden", "Cliente", "Vehículo", "Servicio", "Fecha", "Estado", "Mecánico", ""].forEach(
        (titulo) => {
          const th = document.createElement("th");
          th.scope = "col";
          th.textContent = titulo;
          filaEncabezado.append(th);
        },
      );
      encabezado.append(filaEncabezado);
      const cuerpo = document.createElement("tbody");

      visibles.forEach((orden) => {
        const fila = document.createElement("tr");
        fila.append(
          crearCelda(`OT-${orden.id_orden}`, "ordenes-id"),
          crearCelda(orden.propietario || "Cliente sin nombre"),
          crearCelda(`${orden.placa} · ${orden.marca} ${orden.modelo}`),
          crearCelda(orden.tipo_servicio || "Servicio general"),
          crearCelda(formatearFechaHora(orden.fecha_apertura)),
        );

        const estadoCelda = document.createElement("td");
        const badge = document.createElement("span");
        badge.className = `badge ${claseEstado(orden.estado)}`;
        badge.textContent = orden.estado;
        estadoCelda.append(badge);
        fila.append(estadoCelda);
        fila.append(crearCelda(orden.mecanico || "Sin asignar"));

        const accion = document.createElement("td");
        if (orden.estado === "Pendiente") {
          const boton = document.createElement("button");
          boton.type = "button";
          boton.className = "btn btn-primary btn-sm";
          boton.textContent = "Revisar";
          boton.addEventListener("click", () => abrirAsignacion(orden));
          accion.append(boton);
        } else {
          accion.textContent = "—";
        }
        fila.append(accion);
        cuerpo.append(fila);
      });

      tabla.append(encabezado, cuerpo);
      contenido.append(tabla);
    }

    function actualizarResumen() {
      document.getElementById("ordenesPendientes")!.textContent = String(
        ordenes.filter((orden) => orden.estado === "Pendiente").length,
      );
      document.getElementById("ordenesEnProceso")!.textContent = String(
        ordenes.filter((orden) => orden.estado === "En Proceso").length,
      );
      document.getElementById("ordenesTotal")!.textContent = String(ordenes.length);
    }

    async function cargarOrdenes() {
      contenido.innerHTML = '<p class="loading">Cargando órdenes…</p>';
      try {
        const [respuestaOrdenes, respuestaMecanicos] = await Promise.all([
          apiFetch<OrdenAdmin[]>("/api/admin/ordenes"),
          apiFetch<Mecanico[]>("/api/usuarios/mecanico"),
        ]);
        ordenes = respuestaOrdenes.data ?? [];
        mecanicos = (respuestaMecanicos.data ?? []).filter(
          (mecanico) => Number(mecanico.activo) === 1,
        );
        actualizarResumen();
        pintarOrdenes();
      } catch (error) {
        contenido.replaceChildren();
        const alerta = document.createElement("p");
        alerta.className = "alert alert-error";
        alerta.textContent =
          error instanceof Error ? error.message : "No se pudieron cargar las órdenes.";
        contenido.append(alerta);
      }
    }

    function abrirAsignacion(orden: OrdenAdmin) {
      ordenSeleccionada = orden;
      document.getElementById("detalleAsignacion")!.textContent =
        `OT-${orden.id_orden} · ${orden.propietario} · ${orden.placa} ${orden.marca} ${orden.modelo}`;
      selectorMecanico.replaceChildren(new Option("Selecciona un mecánico", ""));
      mecanicos.forEach((mecanico) => {
        selectorMecanico.add(new Option(mecanico.nombre_completo, String(mecanico.id_usuario)));
      });
      const confirmar = document.getElementById("btnConfirmarAsignacion") as HTMLButtonElement;
      confirmar.disabled = mecanicos.length === 0;
      if (mecanicos.length === 0) {
        notificarError("No hay mecánicos activos disponibles para asignar.");
      }
      modal.showModal();
    }

    botonesFiltro.forEach((boton) => {
      boton.addEventListener("click", () => {
        botonesFiltro.forEach((elemento) => elemento.classList.remove("active"));
        boton.classList.add("active");
        filtroActual = boton.dataset.filtro ?? "Todas";
        pintarOrdenes();
      });
    });

    buscar.addEventListener("input", pintarOrdenes);
    document.getElementById("btnRecargarOrdenes")!.addEventListener("click", () => {
      void cargarOrdenes();
    });
    document.getElementById("btnCerrarAsignacion")!.addEventListener("click", () => modal.close());
    document.getElementById("btnCancelarAsignacion")!.addEventListener("click", () => modal.close());

    formulario.addEventListener("submit", async (evento) => {
      evento.preventDefault();
      if (!ordenSeleccionada || !selectorMecanico.value) return;

      const confirmar = document.getElementById("btnConfirmarAsignacion") as HTMLButtonElement;
      confirmar.disabled = true;
      try {
        const respuesta = await apiFetch(
          `/api/admin/ordenes/${ordenSeleccionada.id_orden}/asignar`,
          {
            method: "PUT",
            body: JSON.stringify({ id_mecanico: Number(selectorMecanico.value) }),
          },
        );
        notificarExito(respuesta.message ?? "Orden aceptada y asignada correctamente.");
        modal.close();
        await cargarOrdenes();
      } catch (error) {
        notificarError(error instanceof Error ? error.message : "No se pudo asignar la orden.");
      } finally {
        confirmar.disabled = mecanicos.length === 0;
      }
    });

    cargarOrdenes();
  </script>
</AdminLayout>