---
import AdminLayout from "../../layouts/AdminLayout.astro";
import {
  ClipboardList,
  Users,
  CarFront,
  Package,
} from "lucide-astro";
---

<AdminLayout title="Dashboard" active="dashboard">
  <section class="admin-welcome">
    <p>Resumen operativo</p>
    <h2>Todo bajo control</h2>
    <span>Consulta el estado actual del taller.</span>
  </section>

  <section class="admin-summary">
    <article class="summary-card">
      <div
        class="summary-icon"
        style="background: var(--blue-soft); color: var(--blue-600);"
      >
        <ClipboardList aria-hidden="true" />
      </div>

      <div>
        <span>Órdenes activas</span>
        <strong id="cnt-ordenes">--</strong>
      </div>
    </article>

    <article class="summary-card">
      <div
        class="summary-icon"
        style="background: var(--ok-soft); color: var(--ok);"
      >
        <Users aria-hidden="true" />
      </div>

      <div>
        <span>Clientes registrados</span>
        <strong id="cnt-clientes">--</strong>
      </div>
    </article>

    <article class="summary-card">
      <div
        class="summary-icon"
        style="background: var(--warn-soft); color: var(--warn);"
      >
        <CarFront aria-hidden="true" />
      </div>

      <div>
        <span>Vehículos registrados</span>
        <strong id="cnt-vehiculos">--</strong>
      </div>
    </article>

    <article class="summary-card">
      <div
        class="summary-icon"
        style="background: var(--danger-soft); color: var(--danger);"
      >
        <Package aria-hidden="true" />
      </div>

      <div>
        <span>Stock crítico</span>
        <strong id="cnt-stock">--</strong>
      </div>
    </article>
  </section>
</AdminLayout>