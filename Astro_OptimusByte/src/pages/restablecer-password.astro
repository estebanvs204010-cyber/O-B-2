---
import AuthLayout from "../layouts/AuthLayout.astro";
---

<AuthLayout title="Restablecer contraseña">
  <p class="auth-sub">
    Escribe tu nueva contraseña para recuperar el acceso.
  </p>

  <div id="reset-alert" class="alert alert-error" hidden></div>

  <form id="reset-form">
    <div class="field">
      <label for="nuevaContrasena">Nueva contraseña</label>
      <input
        id="nuevaContrasena"
        name="nuevaContrasena"
        type="password"
        minlength="8"
        required
      />
    </div>

    <div class="field">
      <label for="confirmarContrasena">Confirmar contraseña</label>
      <input
        id="confirmarContrasena"
        name="confirmarContrasena"
        type="password"
        minlength="8"
        required
      />
    </div>

    <button id="reset-submit" class="btn btn-primary btn-block" type="submit">
      Actualizar contraseña
    </button>
  </form>

  <p class="auth-footer">
    <a href="/login">Volver al inicio de sesión</a>
  </p>
</AuthLayout>

<script>
  import { apiFetch } from "../lib/api";

  const form = document.getElementById("reset-form") as HTMLFormElement;
  const alertBox = document.getElementById("reset-alert") as HTMLDivElement;
  const submitButton = document.getElementById("reset-submit") as HTMLButtonElement;
  const nuevaContrasena = document.getElementById("nuevaContrasena") as HTMLInputElement;
  const confirmarContrasena = document.getElementById("confirmarContrasena") as HTMLInputElement;

  const token = new URLSearchParams(window.location.search).get("token");

  function mostrarError(mensaje: string) {
    alertBox.textContent = mensaje;
    alertBox.removeAttribute("hidden");
  }

  if (!token) {
    mostrarError("El enlace de recuperación no es válido o está incompleto.");
    submitButton.disabled = true;
  }

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    alertBox.setAttribute("hidden", "true");

    if (!token) {
      mostrarError("El enlace de recuperación no es válido.");
      return;
    }

    if (nuevaContrasena.value.length < 8) {
      mostrarError("La contraseña debe tener al menos 8 caracteres.");
      return;
    }

    if (nuevaContrasena.value !== confirmarContrasena.value) {
      mostrarError("Las contraseñas no coinciden.");
      return;
    }

    submitButton.disabled = true;
    submitButton.textContent = "Actualizando...";

    try {
      const resultado = await apiFetch("/api/auth/restablecer-password", {
        method: "POST",
        body: JSON.stringify({
          token,
          nuevaContrasena: nuevaContrasena.value,
        }),
      });

      alertBox.className = "alert alert-ok";
      alertBox.textContent = resultado.message ?? "Contraseña actualizada correctamente.";
      alertBox.removeAttribute("hidden");
      form.reset();
      submitButton.disabled = true;

      setTimeout(() => {
        window.location.href = "/login";
      }, 1800);
    } catch (error) {
      mostrarError(
        error instanceof Error
          ? error.message
          : "No se pudo actualizar la contraseña.",
      );
      submitButton.disabled = false;
      submitButton.textContent = "Actualizar contraseña";
    }
  });
</script>
