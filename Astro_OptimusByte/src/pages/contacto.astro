---
import PublicLayout from '../layouts/PublicLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import Icon from '../components/Icon.astro';
import { TALLER, iconoWhatsApp } from '../data/taller';

const mapaUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${TALLER.direccion}, ${TALLER.ciudad}`)}`;
---
<PublicLayout title="Contacto | Taller Mecánico OptimusByte" description="Contáctanos: teléfono, WhatsApp, correo, dirección y horario de atención de OptimusByte.">
  <PageBanner
    eyebrow="Hablemos"
    titulo="Contacto"
    texto="Escríbenos o visítanos. Estamos para resolver las dudas de tu vehículo."
  />

  <section class="hm-section">
    <div class="hm-wrap">
      <div class="hm-contact-cards">
        <a class="hm-contact-card" href={`https://wa.me/${TALLER.whatsapp}`} target="_blank" rel="noopener" data-reveal>
          <span class="hm-contact-icon"><svg viewBox="0 0 24 24" fill="currentColor"><path d={iconoWhatsApp} /></svg></span>
          <h3>WhatsApp</h3>
          <p>{TALLER.telefono}</p>
        </a>
        <a class="hm-contact-card" href={`tel:+${TALLER.whatsapp}`} data-reveal style="transition-delay:.06s">
          <span class="hm-contact-icon"><Icon name="phone" /></span>
          <h3>Llámanos</h3>
          <p>{TALLER.telefono}</p>
        </a>
        <a class="hm-contact-card" href={`mailto:${TALLER.correo}`} data-reveal style="transition-delay:.12s">
          <span class="hm-contact-icon"><Icon name="mail" /></span>
          <h3>Correo</h3>
          <p>{TALLER.correo}</p>
        </a>
        <a class="hm-contact-card" href={mapaUrl} target="_blank" rel="noopener" data-reveal style="transition-delay:.18s">
          <span class="hm-contact-icon"><Icon name="pin" /></span>
          <h3>Visítanos</h3>
          <p>{TALLER.direccion}<br />{TALLER.ciudad}</p>
        </a>
      </div>
    </div>
  </section>

  <section class="hm-section hm-section--gray">
    <div class="hm-wrap hm-split">
      <div data-reveal>
        <div class="hm-section-head" style="margin-bottom:22px;">
          <p class="hm-eyebrow">Horario</p>
          <h2>Cuándo atendemos</h2>
        </div>
        <ul class="hm-hours">
          {TALLER.horario.map(([dia, hora]) => <li><span>{dia}</span><strong>{hora}</strong></li>)}
        </ul>
        <a href={mapaUrl} target="_blank" rel="noopener" class="hm-btn" style="margin-top:26px;">Cómo llegar</a>
      </div>

      <form class="hm-form" data-wa-form data-wa={TALLER.whatsapp} data-reveal>
        <div class="full">
          <h3 class="hm-form-title">Déjanos tu mensaje</h3>
        </div>
        <div>
          <label>Nombre</label>
          <input name="nombre" type="text" placeholder="Tu nombre" required />
        </div>
        <div>
          <label>Teléfono</label>
          <input name="telefono" type="tel" placeholder="300 000 0000" required />
        </div>
        <div class="full">
          <label>Mensaje</label>
          <textarea name="mensaje" placeholder="¿En qué podemos ayudarte?" required></textarea>
        </div>
        <div class="full">
          <button type="submit" class="hm-btn hm-btn--blue" style="width:100%;">Enviar por WhatsApp</button>
        </div>
      </form>
    </div>
  </section>

  <script>
    document.querySelectorAll<HTMLFormElement>('form[data-wa-form]').forEach((form) => {
      if (form.querySelector('[name="vehiculo"]')) return; // el formulario de cotización ya tiene su propio script
      form.addEventListener('submit', (ev) => {
        ev.preventDefault();
        const f = new FormData(form);
        const texto = `Hola, soy ${f.get('nombre')} (${f.get('telefono')}).\n${f.get('mensaje')}`;
        window.open(`https://wa.me/${form.dataset.wa}?text=${encodeURIComponent(texto)}`, '_blank', 'noopener');
      });
    });
  </script>
</PublicLayout>
