---
import { ICONS } from '../data/icons';

interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size, class: className } = Astro.props;
const dim = size ? { width: size, height: size } : {};
---
<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class:list={['ic', className]}
  {...dim}
  set:html={ICONS[name] ?? ''}
/>
