---
import "../styles/variables.css";
import "../styles/base.css";
import "../styles/components/cliente.css";

interface Props {
  title?: string;
  active?: string;
}

const {
  title = "Panel del Cliente",
  active = "inicio",
} = Astro.props;

const navItems = [
  { id: "inicio", label: "Inicio", href: "/cliente" },
  { id: "vehiculos", label: "Vehículos", href: "/cliente#vehiculos" },
  { id: "ordenes", label: "Órdenes", href: "/cliente#ordenes" },
  { id: "citas", label: "Citas", href: "/cliente#citas" },
  { id: "pagos", label: "Pagos", href: "/cliente#pagos" },
  { id: "perfil", label: "Perfil", href: "/cliente#perfil" },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} - Optimus Byte</title>
  </head>

  <body>
    <div class="app-shell">
      <aside class="sidebar">
        <a class="sidebar-brand" href="/cliente">
          Optimus <span class="accent">Byte</span>
        </a>

        <div class="sidebar-section">Portal Cliente</div>

        <nav class="sidebar-nav" aria-label="Navegación del cliente">
          {
            navItems.map((item) => (
              <a
                class:list={["sidebar-link", active === item.id && "active"]}
                data-section={item.id}
                href={item.href}
              >
                {item.label}
              </a>
            ))
          }
        </nav>

        <div class="sidebar-user">
          <div class="avatar">C</div>

          <div class="sidebar-user-info">
            <strong>Cliente</strong>

            <button id="logoutButton" type="button">
              Cerrar sesión
            </button>
          </div>
        </div>
      </aside>

      <main class="main">
        <header class="topbar">
          <div>
            <h1>{title}</h1>
            <p>Gestiona la información de tus vehículos y servicios.</p>
          </div>

          <a class="btn btn-outline btn-sm" href="/">
            Volver al sitio
          </a>
        </header>

        <div class="client-content">
          <slot />
        </div>
      </main>
    </div>

    <script>
      import { cerrarSesion } from "../lib/api";

      const logoutButton = document.getElementById("logoutButton");

      logoutButton?.addEventListener("click", async () => {
        logoutButton.setAttribute("disabled", "true");
        logoutButton.textContent = "Cerrando sesión...";

        await cerrarSesion();

        window.location.href = "/login";
      });

      const links = Array.from(
        document.querySelectorAll<HTMLAnchorElement>("[data-section]"),
      );

      function marcarSeccion(id: string) {
        links.forEach((link) => {
          const activo = link.dataset.section === id;

          link.classList.toggle("active", activo);

          if (activo) {
            link.setAttribute("aria-current", "page");
          } else {
            link.removeAttribute("aria-current");
          }
        });
      }

      function actualizarSeccionDesdeHash() {
        const hash = window.location.hash.replace("#", "");

        marcarSeccion(hash || "inicio");
      }

      links.forEach((link) => {
        link.addEventListener("click", () => {
          const section = link.dataset.section;

          if (section) {
            marcarSeccion(section);
          }
        });
      });

      window.addEventListener("hashchange", actualizarSeccionDesdeHash);

      actualizarSeccionDesdeHash();
    </script>
  </body>
</html>