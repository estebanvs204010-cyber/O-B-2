---
import "../styles/variables.css";
import "../styles/base.css";
import "../styles/components/cliente.css";

interface Props {
  title?: string;
  active?: string;
}

const {
  title = "Panel del Cliente",
  active = "inicio",
} = Astro.props;

const navItems = [
  { id: "inicio", label: "Inicio", href: "/cliente", icon: "home" },
  { id: "vehiculos", label: "Mis Vehículos", href: "/cliente/vehiculos", icon: "car" },
  { id: "ordenes", label: "Órdenes de Servicio", href: "/cliente/ordenes", icon: "wrench" },
  { id: "citas", label: "Agendar Citas", href: "/cliente/citas", icon: "calendar" },
  { id: "pagos", label: "Pagos y Compras", href: "/cliente/pagos", icon: "credit-card" },
  { id: "perfil", label: "Mi Perfil", href: "/cliente/perfil", icon: "user" },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title} · OptimusByte</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>

  <body>
    <div class="app-shell">
      <!-- Backdrop móvil -->
      <div id="sidebarBackdrop" class="sidebar-backdrop" style="display:none;"></div>

      <!-- Barra lateral -->
      <aside class="sidebar" id="clienteSidebar">
        <a class="sidebar-brand" href="/cliente" title="OptimusByte Panel Cliente">
          <img src="/images/logo.png" alt="OptimusByte" class="sidebar-logo-img" />
        </a>

        <div class="sidebar-section">Mi Cuenta</div>

        <nav class="sidebar-nav" aria-label="Navegación del cliente">
          {
            navItems.map((item) => (
              <a
                class:list={["sidebar-link", active === item.id && "active"]}
                href={item.href}
              >
                {item.icon === "home" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                )}
                {item.icon === "car" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.5 2.8C2.1 10.7 2 11 2 11.3V16c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/></svg>
                )}
                {item.icon === "wrench" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
                )}
                {item.icon === "calendar" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                )}
                {item.icon === "credit-card" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                )}
                {item.icon === "user" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                )}
                <span>{item.label}</span>
              </a>
            ))
          }

          <a href="/" class="sidebar-link sidebar-link-store" title="Ir al catálogo y compras">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            <span>Ir a la Tienda / Inicio</span>
          </a>
        </nav>

        <div class="sidebar-user">
          <div class="avatar" id="sidebarAvatar">C</div>

          <div class="sidebar-user-info">
            <strong id="sidebarNombre">Cliente</strong>
            <button id="logoutButton" type="button" title="Cerrar sesión">
              Cerrar sesión
            </button>
          </div>
        </div>
      </aside>

      <!-- Contenido Principal -->
      <main class="main">
        <header class="topbar">
          <div style="display:flex; align-items:center; gap:12px;">
            <button id="mobileMenuBtn" class="mobile-toggle" aria-label="Abrir menú">
              <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
            </button>
            <div class="topbar-info">
              <h1>{title}</h1>
              <p>OptimusByte · Gestión de vehículos, servicios y repuestos</p>
            </div>
          </div>

          <div class="topbar-actions">
            <a class="topbar-home-btn" href="/" title="Regresar a la página principal conservando tu sesión">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
              <span>Volver a la tienda</span>
            </a>
          </div>
        </header>

        <div class="client-content">
          <slot />
        </div>
      </main>
    </div>

    <script>
      import { cerrarSesion, apiFetch } from "../lib/api";

      // Cargar datos del perfil en el sidebar
      async function cargarPerfilSidebar() {
        try {
          const resp = await apiFetch<any>("/api/cliente/me");
          if (resp.data) {
            const nombre = resp.data.nombre_completo || "Cliente";
            const nombreEl = document.getElementById("sidebarNombre");
            const avatarEl = document.getElementById("sidebarAvatar");

            if (nombreEl) nombreEl.textContent = nombre.split(" ")[0] || "Cliente";
            if (avatarEl) {
              if (resp.data.foto_perfil) {
                avatarEl.innerHTML = `<img src="${resp.data.foto_perfil}" alt="${nombre}" />`;
              } else {
                avatarEl.textContent = nombre.charAt(0).toUpperCase();
              }
            }
          }
        } catch {
          // Si falla, se conservan los valores por defecto
        }
      }

      cargarPerfilSidebar();

      // Menú móvil
      const menuBtn = document.getElementById("mobileMenuBtn");
      const sidebar = document.getElementById("clienteSidebar");
      const backdrop = document.getElementById("sidebarBackdrop");

      menuBtn?.addEventListener("click", () => {
        sidebar?.classList.toggle("is-open");
        if (backdrop) backdrop.style.display = sidebar?.classList.contains("is-open") ? "block" : "none";
      });

      backdrop?.addEventListener("click", () => {
        sidebar?.classList.remove("is-open");
        backdrop.style.display = "none";
      });

      // Cierre de sesión
      const logoutButton = document.getElementById("logoutButton");
      logoutButton?.addEventListener("click", async () => {
        logoutButton.setAttribute("disabled", "true");
        logoutButton.textContent = "Cerrando sesión...";

        try {
          await cerrarSesion();
        } finally {
          window.location.href = "/login";
        }
      });
    </script>
  </body>
</html>
