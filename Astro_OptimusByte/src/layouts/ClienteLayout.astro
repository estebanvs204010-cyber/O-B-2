---
interface Props {
  title?: string;
  active?: string;
}

const { title = "Panel Cliente", active = "inicio" } = Astro.props;

const navItems = [
  { id: "inicio", label: "Inicio", href: "/cliente" },
  { id: "vehiculos", label: "Vehiculos", href: "/cliente#vehiculos" },
  { id: "ordenes", label: "Ordenes", href: "/cliente#ordenes" },
  { id: "citas", label: "Citas", href: "/cliente#citas" },
  { id: "pagos", label: "Pagos", href: "/cliente#pagos" },
  { id: "perfil", label: "Perfil", href: "/cliente#perfil" },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} - Optimus Byte</title>
  </head>
  <body>
    <div class="cliente-shell">
      <aside class="cliente-sidebar">
        <a class="brand" href="/cliente" aria-label="Ir al panel de cliente">
          <span class="brand-mark">OB</span>
          <span>
            <strong>Optimus Byte</strong>
            <small>Portal cliente</small>
          </span>
        </a>

        <nav class="cliente-nav" aria-label="Navegacion principal">
          {
            navItems.map((item) => (
              <a class:list={["nav-item", active === item.id && "is-active"]} href={item.href}>
                {item.label}
              </a>
            ))
          }
        </nav>
      </aside>

      <div class="cliente-main">
        <header class="cliente-topbar">
          <div>
            <p class="eyebrow">Cliente</p>
            <h1>{title}</h1>
          </div>

          <div class="topbar-actions">
            <a class="ghost-link" href="/">Volver al sitio</a>
            <button class="logout-button" id="logoutButton" type="button">Cerrar sesion</button>
          </div>
        </header>

        <main class="cliente-content">
          <slot />
        </main>
      </div>
    </div>

    <script>
      const logoutButton = document.getElementById("logoutButton");

      logoutButton?.addEventListener("click", () => {
        localStorage.removeItem("token");
        sessionStorage.removeItem("token");
        window.location.href = "/";
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --ob-blue: #2563eb;
    --ob-blue-dark: #1e40af;
    --ob-ink: #111827;
    --ob-muted: #64748b;
    --ob-line: #dbe5f3;
    --ob-bg: #f6f8fc;
    --ob-panel: #ffffff;
    --ob-success: #15803d;
    --ob-warning: #a16207;
    --ob-danger: #b91c1c;
    --ob-radius: 8px;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    min-height: 100%;
    margin: 0;
    background: var(--ob-bg);
    color: var(--ob-ink);
  }

  body {
    min-width: 320px;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button {
    font: inherit;
  }

  .cliente-shell {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 268px minmax(0, 1fr);
  }

  .cliente-sidebar {
    position: sticky;
    top: 0;
    height: 100vh;
    padding: 24px 18px;
    background: #ffffff;
    border-right: 1px solid var(--ob-line);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 8px 22px;
    border-bottom: 1px solid var(--ob-line);
  }

  .brand-mark {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border-radius: var(--ob-radius);
    background: var(--ob-blue);
    color: #ffffff;
    font-weight: 800;
    letter-spacing: 0;
  }

  .brand strong {
    display: block;
    font-size: 1rem;
    line-height: 1.1;
  }

  .brand small {
    display: block;
    margin-top: 4px;
    color: var(--ob-muted);
    font-size: .8rem;
  }

  .cliente-nav {
    display: grid;
    gap: 6px;
    margin-top: 22px;
  }

  .nav-item {
    padding: 11px 12px;
    border-radius: var(--ob-radius);
    color: #475569;
    font-weight: 650;
    border: 1px solid transparent;
  }

  .nav-item:hover,
  .nav-item.is-active {
    color: var(--ob-blue);
    background: #eff6ff;
    border-color: #bfdbfe;
  }

  .cliente-main {
    min-width: 0;
  }

  .cliente-topbar {
    position: sticky;
    top: 0;
    z-index: 5;
    min-height: 82px;
    padding: 18px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    background: rgba(255, 255, 255, .92);
    border-bottom: 1px solid var(--ob-line);
    backdrop-filter: blur(10px);
  }

  .cliente-topbar h1 {
    margin: 2px 0 0;
    font-size: clamp(1.35rem, 2vw, 1.9rem);
    line-height: 1.1;
    letter-spacing: 0;
  }

  .eyebrow {
    margin: 0;
    color: var(--ob-blue);
    font-size: .72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .08em;
  }

  .topbar-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .ghost-link,
  .logout-button,
  .primary-button,
  .secondary-button {
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--ob-radius);
    border: 1px solid var(--ob-line);
    padding: 0 14px;
    background: #ffffff;
    color: #1f2937;
    font-weight: 750;
    cursor: pointer;
  }

  .logout-button {
    color: var(--ob-danger);
    border-color: #fecaca;
  }

  .primary-button {
    background: var(--ob-blue);
    border-color: var(--ob-blue);
    color: #ffffff;
  }

  .cliente-content {
    padding: 28px 32px 40px;
  }

  .page-grid {
    display: grid;
    gap: 20px;
  }

  .summary-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .metric-card,
  .panel,
  .vehicle-card,
  .profile-card {
    background: var(--ob-panel);
    border: 1px solid var(--ob-line);
    border-radius: var(--ob-radius);
    box-shadow: 0 10px 24px rgba(15, 23, 42, .05);
  }

  .metric-card {
    min-height: 112px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .metric-label {
    margin: 0;
    color: var(--ob-muted);
    font-size: .8rem;
    font-weight: 750;
    text-transform: uppercase;
    letter-spacing: .08em;
  }

  .metric-value {
    margin: 10px 0 0;
    font-size: 1.8rem;
    line-height: 1;
    font-weight: 850;
  }

  .metric-note {
    margin: 8px 0 0;
    color: var(--ob-muted);
    font-size: .88rem;
  }

  .content-columns {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(320px, .65fr);
    gap: 20px;
    align-items: start;
  }

  .panel {
    overflow: hidden;
  }

  .panel-header {
    padding: 18px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border-bottom: 1px solid var(--ob-line);
  }

  .panel-title {
    margin: 0;
    font-size: 1rem;
    letter-spacing: 0;
  }

  .panel-subtitle {
    margin: 4px 0 0;
    color: var(--ob-muted);
    font-size: .9rem;
  }

  .panel-body {
    padding: 18px 20px;
  }

  .vehicle-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .vehicle-card {
    padding: 16px;
    display: grid;
    gap: 14px;
  }

  .vehicle-card h3 {
    margin: 0;
    font-size: 1rem;
  }

  .vehicle-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 0 10px;
    border-radius: 999px;
    background: #f1f5f9;
    color: #334155;
    font-size: .82rem;
    font-weight: 700;
  }

  .pill.success {
    background: #dcfce7;
    color: var(--ob-success);
  }

  .pill.warning {
    background: #fef3c7;
    color: var(--ob-warning);
  }

  .progress {
    height: 8px;
    overflow: hidden;
    border-radius: 999px;
    background: #e2e8f0;
  }

  .progress span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--ob-blue);
  }

  .table-wrap {
    width: 100%;
    overflow-x: auto;
  }

  .data-table {
    width: 100%;
    min-width: 720px;
    border-collapse: collapse;
  }

  .data-table th,
  .data-table td {
    padding: 14px 16px;
    border-bottom: 1px solid var(--ob-line);
    text-align: left;
    vertical-align: middle;
  }

  .data-table th {
    color: var(--ob-blue);
    background: #f8fbff;
    font-size: .78rem;
    text-transform: uppercase;
    letter-spacing: .08em;
  }

  .data-table td {
    color: #1f2937;
    font-size: .94rem;
  }

  .list-stack {
    display: grid;
    gap: 12px;
  }

  .list-item {
    padding: 14px;
    display: grid;
    gap: 8px;
    border: 1px solid var(--ob-line);
    border-radius: var(--ob-radius);
    background: #ffffff;
  }

  .list-item strong {
    font-size: .95rem;
  }

  .list-item span {
    color: var(--ob-muted);
    font-size: .88rem;
  }

  .quick-actions {
    display: grid;
    gap: 10px;
  }

  .quick-actions a {
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 0 14px;
    border: 1px solid var(--ob-line);
    border-radius: var(--ob-radius);
    background: #ffffff;
    font-weight: 750;
  }

  .profile-card {
    padding: 18px;
  }

  .profile-card dl {
    margin: 16px 0 0;
    display: grid;
    gap: 12px;
  }

  .profile-card dt {
    color: var(--ob-muted);
    font-size: .78rem;
    text-transform: uppercase;
    letter-spacing: .08em;
    font-weight: 800;
  }

  .profile-card dd {
    margin: 3px 0 0;
    font-weight: 700;
  }

  @media (max-width: 1100px) {
    .summary-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .content-columns,
    .vehicle-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 780px) {
    .cliente-shell {
      grid-template-columns: 1fr;
    }

    .cliente-sidebar {
      position: static;
      height: auto;
      padding: 16px;
    }

    .cliente-nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .cliente-topbar {
      position: static;
      align-items: flex-start;
      flex-direction: column;
      padding: 18px;
    }

    .topbar-actions {
      width: 100%;
      justify-content: stretch;
    }

    .ghost-link,
    .logout-button {
      flex: 1;
    }

    .cliente-content {
      padding: 18px;
    }
  }

  @media (max-width: 540px) {
    .summary-grid,
    .cliente-nav {
      grid-template-columns: 1fr;
    }
  }
</style>
