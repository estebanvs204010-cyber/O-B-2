---
import {
  Wrench,
  LayoutDashboard,
  ClipboardList,
  Users,
  HardHat,
  CarFront,
  Package,
  FileText,
  LogOut,
} from "lucide-astro";

interface Props {
  active: "dashboard" | "clientes" | "ordenes" | "repuestos" | "vehiculos" | "facturacion" | "mecanicos" | "citas";
  active:
    | "dashboard"
    | "clientes"
    | "ordenes"
    | "repuestos"
    | "vehiculos"
    | "facturacion"
    | "mecanicos";
}

const { active } = Astro.props;
---

<aside class="admin-sidebar">

  <!-- Logo -->
  <a class="admin-brand" href="/admin">
    <span class="brand-icon">
      <i class="bi bi-wrench-adjustable-circle-fill"></i>
    </span>
    <span class="brand-icon">
      <Wrench aria-hidden="true" />
    </span>

    <span>Optimus<span class="brand-accent">Byte</span></span>
  </a>

  <nav class="admin-nav">

  <nav class="admin-nav" aria-label="Navegacion administrativa">
    <p class="admin-nav-title">Principal</p>
    <a href="/admin"
       class:list={["admin-nav-link", { active: active === "dashboard" }]}>
      <i class="bi bi-speedometer2"></i>

    <a
      href="/admin"
      class:list={["admin-nav-link", { active: active === "dashboard" }]}
    >
      <LayoutDashboard aria-hidden="true" />
      Dashboard
    </a>

    <p class="admin-nav-title">Gestión</p>
    <a href="/admin/ordenes"
       class:list={["admin-nav-link", { active: active === "ordenes" }]}>
      <i class="bi bi-clipboard2-check"></i>
      Órdenes
    </a>
    <a href="/admin/citas"
       class:list={["admin-nav-link", { active: active === "citas" }]}>
      <i class="bi bi-calendar2-check"></i>
      Citas
    </a>
    <a href="/admin/clientes"
       class:list={["admin-nav-link", { active: active === "clientes" }]}>
      <i class="bi bi-people"></i>
      Clientes
    </a>
    <a href="/admin/mecanicos"
       class:list={["admin-nav-link", { active: active === "mecanicos" }]}>
      <i class="bi bi-person-workspace"></i>
      Mecánicos
    </a>
    <a href="/admin/vehiculos"
       class:list={["admin-nav-link", { active: active === "vehiculos" }]}>
      <i class="bi bi-car-front"></i>
      Vehículos
    </a>
    <a href="/admin/repuestos"
       class:list={["admin-nav-link", { active: active === "repuestos" }]}>
      <i class="bi bi-box-seam"></i>
    <p class="admin-nav-title">Gestion</p>

    <a
      href="/admin/ordenes"
      class:list={["admin-nav-link", { active: active === "ordenes" }]}
    >
      <ClipboardList aria-hidden="true" />
      Ordenes
    </a>

    <a
      href="/admin/clientes"
      class:list={["admin-nav-link", { active: active === "clientes" }]}
    >
      <Users aria-hidden="true" />
      Clientes
    </a>

    <a
      href="/admin/mecanicos"
      class:list={["admin-nav-link", { active: active === "mecanicos" }]}
    >
      <HardHat aria-hidden="true" />
      Mecanicos
    </a>

    <a
      href="/admin/vehiculos"
      class:list={["admin-nav-link", { active: active === "vehiculos" }]}
    >
      <CarFront aria-hidden="true" />
      Vehiculos
    </a>

    <a
      href="/admin/repuestos"
      class:list={["admin-nav-link", { active: active === "repuestos" }]}
    >
      <Package aria-hidden="true" />
      Repuestos
    </a>
    <a href="/admin/facturacion"
       class:list={["admin-nav-link", { active: active === "facturacion" }]}>
      <i class="bi bi-receipt"></i>
      Facturación

    <a
      href="/admin/facturacion"
      class:list={["admin-nav-link", { active: active === "facturacion" }]}
    >
      <FileText aria-hidden="true" />
      Facturacion
    </a>

  </nav>

  <div class="admin-user">
    <div class="admin-avatar">A</div>
    <div>
      <strong>Administrador</strong>
      <span>Admin</span>
    </div>
    <button id="ob-logout" type="button" title="Cerrar sesión">
      <i class="bi bi-box-arrow-right"></i>

    <button
      id="ob-logout"
      type="button"
      title="Cerrar sesion"
      aria-label="Cerrar sesion"
    >
      <LogOut aria-hidden="true" />
    </button>
  </div>

</aside>