---
interface Props {
  active: "dashboard" | "clientes";
}

const { active } = Astro.props;
---

<aside class="admin-sidebar">
  <a class="admin-brand" href="/admin">
    <span class="brand-icon">&#9881;</span>
    <span>Optimus<span class="brand-accent">Byte</span></span>
  </a>

  <nav class="admin-nav">
    <p class="admin-nav-title">Principal</p>

    <a
      href="/admin"
      class:list={["admin-nav-link", { active: active === "dashboard" }]}
    >
      <span>&#9638;</span>
      Dashboard
    </a>

    <p class="admin-nav-title">Gestion</p>

    <a class="admin-nav-link" href="/admin#ordenes">
      <span>&#9776;</span>
      Ordenes
    </a>

    <a class="admin-nav-link" href="/admin#repuestos">
      <span>&#9881;</span>
      Repuestos
    </a>

    <a
     href="/admin/clientes"
       class:list={["admin-nav-link", { active: active === "clientes" }]}
    >
    <span>&#9787;</span>
        Clientes
    </a>
  </nav>

  <div class="admin-user">
    <div class="admin-avatar">A</div>

    <div>
      <strong>Administrador</strong>
      <span>Admin</span>
    </div>

    <button id="ob-logout" type="button" title="Cerrar sesion">
      &#10005;
    </button>
  </div>
</aside>