---
const { title } = Astro.props;
---

<header class="admin-topbar">
  <h1>{title}</h1>

  <div class="topbar-actions">
    <button class="topbar-btn" type="button" title="Notificaciones">
      <i class="bi bi-bell"></i>
      <span class="notif-dot"></span>
    </button>
    <div class="topbar-sep"></div>

  </div>
</header>