---
import { Bell } from "lucide-astro";

const { title } = Astro.props;
---

<header class="admin-topbar">
  <h1>{title}</h1>

  <div class="topbar-actions">
    <div class="notification-menu">
      <button
        id="admin-notifications"
        class="topbar-btn"
        type="button"
        title="Notificaciones"
        aria-label="Notificaciones"
        aria-expanded="false"
        aria-controls="admin-notification-panel"
      >
        <Bell aria-hidden="true" />
        <span id="notification-badge" class="notif-badge" hidden></span>
      </button>

      <section
        id="admin-notification-panel"
        class="notification-panel"
        aria-label="Notificaciones pendientes"
        hidden
      >
        <header class="notification-panel-header">
          <strong>Notificaciones</strong>
          <span id="notification-summary">Pendientes</span>
        </header>
        <div id="notification-list" class="notification-list" aria-live="polite">
          <p class="notification-empty">Cargando notificaciones…</p>
        </div>
      </section>
    </div>

  </div>
</header>

<script>
  import { apiFetch, formatearFechaHora } from "../../lib/api";
  import { notificarError, notificarExito } from "../../lib/toast";

  interface SolicitudPendiente {
    id_solicitud: number;
    id_orden: number;
    nombre_repuesto: string;
    cantidad: number;
    fecha_solicitud: string;
    placa: string;
    mecanico: string;
  }

  interface SolicitudClientePendiente {
    id_solicitud_cliente: number;
    nombre_repuesto: string;
    referencia: string | null;
    cantidad: number;
    descripcion: string | null;
    imagen_url: string | null;
    fecha_solicitud: string;
    cliente: string;
  }

  interface NotificacionesAdmin {
    ordenes: Array<{
      id_orden: number;
      estado: string;
      tipo_servicio: string;
      fecha_apertura: string;
      placa: string;
      propietario: string;
    }>;
    solicitudes: SolicitudPendiente[];
    solicitudesClientes: SolicitudClientePendiente[];
  }

  type Notificacion =
    | { tipo: "orden"; id: number; fecha: string; titulo: string; detalle: string }
    | { tipo: "repuesto"; id: number; fecha: string; titulo: string; detalle: string }
    | { tipo: "solicitud-cliente"; id: number; fecha: string; titulo: string; detalle: string; imagenUrl: string | null };

  const button = document.getElementById("admin-notifications") as HTMLButtonElement | null;
  const panel = document.getElementById("admin-notification-panel") as HTMLElement | null;
  const badge = document.getElementById("notification-badge") as HTMLSpanElement | null;
  const summary = document.getElementById("notification-summary") as HTMLSpanElement | null;
  const list = document.getElementById("notification-list") as HTMLDivElement | null;

  if (button && panel && badge && summary && list) {
    const notificationButton = button;
    const notificationPanel = panel;
    const notificationBadge = badge;
    const notificationSummary = summary;
    const notificationList = list;

    function togglePanel(open: boolean) {
      notificationPanel.hidden = !open;
      notificationButton.setAttribute("aria-expanded", String(open));
    }

    function crearNotificacion(item: Notificacion) {
      const card = document.createElement("article");
      card.className = "notification-card";

      const link = document.createElement("a");
      link.className = "notification-item";
      link.href = item.tipo === "solicitud-cliente" ? "/admin/repuestos" : "/admin/ordenes";

      const title = document.createElement("strong");
      title.textContent = item.titulo;
      const detail = document.createElement("span");
      detail.textContent = item.detalle;
      const date = document.createElement("time");
      date.textContent = formatearFechaHora(item.fecha);
      link.append(title, detail, date);
      card.append(link);

      if (item.tipo === "solicitud-cliente" && item.imagenUrl) {
        const imageLink = document.createElement("a");
        imageLink.className = "notification-image-link";
        imageLink.href = item.imagenUrl;
        imageLink.target = "_blank";
        imageLink.rel = "noopener noreferrer";
        imageLink.textContent = "Ver imagen";
        imageLink.setAttribute("aria-label", `Ver imagen de referencia de ${item.titulo}`);
        card.append(imageLink);
      }

      if (item.tipo === "repuesto" || item.tipo === "solicitud-cliente") {
        const attendButton = document.createElement("button");
        attendButton.className = "notification-attend";
        attendButton.type = "button";
        attendButton.textContent = "Marcar atendida";
        attendButton.addEventListener("click", async () => {
          attendButton.disabled = true;
          try {
            const ruta = item.tipo === "solicitud-cliente"
              ? `/api/admin/solicitudes-repuesto-cliente/${item.id}/atender`
              : `/api/mecanico/solicitudes-repuesto/${item.id}/atender`;
            await apiFetch(ruta, {
              method: "PUT",
            });
            notificarExito("Solicitud marcada como atendida");
            await cargarNotificaciones();
          } catch (error) {
            notificarError(
              error instanceof Error ? error.message : "No se pudo actualizar la solicitud",
            );
            attendButton.disabled = false;
          }
        });
        card.append(attendButton);
      }

      return card;
    }

    function mostrarNotificaciones(notificaciones: Notificacion[]) {
      notificationBadge.hidden = notificaciones.length === 0;
      notificationBadge.textContent = notificaciones.length > 99 ? "99+" : String(notificaciones.length);
      notificationSummary.textContent = notificaciones.length === 1
        ? "1 pendiente"
        : `${notificaciones.length} pendientes`;
      notificationList.replaceChildren();

      if (notificaciones.length === 0) {
        const empty = document.createElement("p");
        empty.className = "notification-empty";
        empty.textContent = "No hay órdenes ni solicitudes de repuestos pendientes.";
        notificationList.append(empty);
        return;
      }

      notificaciones.forEach((item) => notificationList.append(crearNotificacion(item)));
    }

    async function cargarNotificaciones() {
      try {
        const response = await apiFetch<NotificacionesAdmin>("/api/admin/notificaciones");
        const ordenes = (response.data?.ordenes ?? [])
          .filter((orden) => orden.estado === "Pendiente")
          .map((orden): Notificacion => ({
            tipo: "orden",
            id: orden.id_orden,
            fecha: orden.fecha_apertura,
            titulo: `Orden OT-${orden.id_orden} pendiente de asignar`,
            detalle: `${orden.tipo_servicio} · ${orden.placa} · ${orden.propietario}`,
          }));
        const solicitudes = (response.data?.solicitudes ?? []).map(
          (solicitud): Notificacion => ({
            tipo: "repuesto",
            id: solicitud.id_solicitud,
            fecha: solicitud.fecha_solicitud,
            titulo: `Pedido de repuesto · OT-${solicitud.id_orden}`,
            detalle: `${solicitud.nombre_repuesto} (x${solicitud.cantidad}) · ${solicitud.mecanico} · ${solicitud.placa}`,
          }),
        );
        const solicitudesClientes = (response.data?.solicitudesClientes ?? []).map(
          (solicitud): Notificacion => ({
            tipo: "solicitud-cliente",
            id: solicitud.id_solicitud_cliente,
            fecha: solicitud.fecha_solicitud,
            titulo: `Repuesto solicitado · ${solicitud.nombre_repuesto}`,
            detalle: `${solicitud.cliente} · ${solicitud.cantidad} unidad${solicitud.cantidad === 1 ? "" : "es"}${solicitud.referencia ? ` · Ref. ${solicitud.referencia}` : ""}${solicitud.descripcion ? ` · ${solicitud.descripcion}` : ""}`,
            imagenUrl: solicitud.imagen_url,
          }),
        );

        mostrarNotificaciones(
          [...ordenes, ...solicitudes, ...solicitudesClientes].sort(
            (a, b) => new Date(b.fecha).getTime() - new Date(a.fecha).getTime(),
          ),
        );
      } catch (error) {
        console.error("No se pudieron cargar las notificaciones administrativas", error);
        notificationList.replaceChildren();
        const message = document.createElement("p");
        message.className = "notification-empty notification-error";
        message.textContent = "No se pudieron cargar las notificaciones.";
        notificationList.append(message);
      }
    }

    notificationButton.addEventListener("click", () => {
      togglePanel(Boolean(notificationPanel.hidden));
    });

    document.addEventListener("click", (event) => {
      if (
        !notificationPanel.contains(event.target as Node) &&
        !notificationButton.contains(event.target as Node)
      ) {
        togglePanel(false);
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") togglePanel(false);
    });

    void cargarNotificaciones();
    window.setInterval(() => void cargarNotificaciones(), 20_000);
  }
</script>